{{ 'drye-nt-close.css' | asset_url | stylesheet_tag }}

<section
  class="drye-nt drye-liner-risk-reversal"
  id="drye-nt-close-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-drye-section
  data-section-name="nt_close"
>
  <div class="dryeNEW-container drye-liner-risk-reversal__inner">
    <div class="drye-liner-risk-reversal__wrap">
      <div class="drye-liner-risk-reversal__badge"><span class="drye-liner-risk-reversal__num">{{ section.settings.days }}</span><span class="drye-liner-risk-reversal__word">{{ section.settings.days_label }}</span></div>
      <div class="drye-liner-risk-reversal__copy">
        <h3>{{ section.settings.heading }}</h3>
        <p>{{ section.settings.body }}</p>
      </div>
    </div>
    <div class="drye-liner-risk-reversal__cta-wrap">
      <a class="dryeNEW-btn dryeNEW-btn--primary" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }}</a>
    </div>
    {%- if section.settings.guarantee != blank -%}
      <p class="drye-liner-risk-reversal__guarantee">{{ section.settings.guarantee }}</p>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.sources != blank -%}
  <div class="drye-nt drye-nt-sources">
    <div class="lp-wrap">
      <p>{{ section.settings.sources }}</p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "DRYE NT — Close",
  "tag": "section",
  "class": "shopify-section-drye-nt-close",
  "settings": [
    { "type": "text", "id": "days", "label": "Badge number", "default": "30" },
    { "type": "text", "id": "days_label", "label": "Badge word", "default": "Days" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try it risk-free." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "If DRYE Liner doesn't change your shift, full refund. No hassle." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get DRYE Liner" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "guarantee", "label": "Guarantee line", "default": "30-Day Money Back Guarantee" },
    { "type": "textarea", "id": "sources", "label": "Source line", "default": "Park & Lee 2025 · Warner, Stone & Boissy, J Invest Dermatol 2003 · Gunt & Kasting, Int J Pharm 2007 · Nogueira et al., Thermochim Acta 2009 · Repeated-occlusion reference pending verification" }
  ],
  "presets": [{ "name": "DRYE NT — Close" }]
}
{% endschema %}
