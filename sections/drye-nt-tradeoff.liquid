{{ 'drye-nt-base.css' | asset_url | stylesheet_tag }}
{{ 'drye-nt-tradeoff.css' | asset_url | stylesheet_tag }}

<section
  class="drye-nt lp-block drye-nt-tradeoff"
  id="drye-nt-tradeoff-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-drye-section
  data-section-name="nt_tradeoff"
>
  <div class="lp-wrap">
    {%- if section.settings.eyebrow != blank -%}
      <p class="cloud-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <p class="cloud">
      {%- for block in section.blocks -%}
        <b class="cw-{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.word }}</b>
      {%- endfor -%}
    </p>

    {%- if section.settings.footer != blank -%}
      <div class="cloud-foot"><i></i><span>{{ section.settings.footer }}</span><i></i></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "DRYE NT — Tradeoffs",
  "tag": "section",
  "class": "shopify-section-drye-nt-tradeoff",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "One glove. Too many tradeoffs." },
    { "type": "text", "id": "footer", "label": "Footer line", "default": "Keep the protection. Lose the tradeoff." }
  ],
  "blocks": [
    {
      "type": "word",
      "name": "Word",
      "settings": [
        { "type": "text", "id": "word", "label": "Word", "default": "Trapped sweat" },
        { "type": "select", "id": "size", "label": "Size", "default": "2",
          "options": [
            { "value": "1", "label": "Large" },
            { "value": "2", "label": "Medium" },
            { "value": "3", "label": "Small" }
          ] }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "DRYE NT — Tradeoffs",
      "blocks": [
        { "type": "word", "settings": { "word": "Trapped sweat", "size": "1" } },
        { "type": "word", "settings": { "word": "Ripping nitriles", "size": "2" } },
        { "type": "word", "settings": { "word": "Smell", "size": "1" } },
        { "type": "word", "settings": { "word": "24/7 washing", "size": "2" } },
        { "type": "word", "settings": { "word": "Discomfort", "size": "3" } },
        { "type": "word", "settings": { "word": "Soft, splitting nails", "size": "1" } },
        { "type": "word", "settings": { "word": "Dry, cracked hands", "size": "2" } },
        { "type": "word", "settings": { "word": "Itching", "size": "3" } },
        { "type": "word", "settings": { "word": "Dermatitis", "size": "2" } },
        { "type": "word", "settings": { "word": "Rashes", "size": "3" } },
        { "type": "word", "settings": { "word": "Wet hands", "size": "3" } }
      ]
    }
  ]
}
{% endschema %}
