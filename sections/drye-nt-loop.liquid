{{ 'drye-nt-loop.css' | asset_url | stylesheet_tag }}

<section
  class="drye-nt lp-block drye-nt-loop"
  id="drye-nt-loop-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-drye-section
  data-section-name="nt_loop"
>
  <div class="lp-wrap">
    <div class="loop-head">
      {%- if section.settings.chapter != blank -%}
        <span class="chapno">{{ section.settings.chapter }}</span>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="loop-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="loop-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="loop-grid">
      {%- for block in section.blocks -%}
        <div class="loop-item" {{ block.shopify_attributes }}>
          {%- if block.settings.avatar != blank -%}
            {{ block.settings.avatar | image_url: width: 320 | image_tag: loading: 'lazy', class: 'loop-av', alt: '' }}
          {%- endif -%}
          <p class="loop-q">{{ block.settings.question }}</p>
          <p class="loop-a">{{ block.settings.answer }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DRYE NT — Advice loop",
  "tag": "section",
  "class": "shopify-section-drye-nt-loop",
  "settings": [
    { "type": "text", "id": "chapter", "label": "Chapter number", "default": "03" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The never-ending loop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "POV: You're stuck in the nail tech advice loop." }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question / answer",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "textarea", "id": "question", "label": "Question" },
        { "type": "text", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "DRYE NT — Advice loop",
      "blocks": [
        { "type": "qa", "settings": { "question": "\u201cI've got dermatitis. What should I do?\u201d", "answer": "— Use thicker mils." } },
        { "type": "qa", "settings": { "question": "\u201cMy hands smell disgusting by the end of the day. What do I do?\u201d", "answer": "— Use powder." } },
        { "type": "qa", "settings": { "question": "\u201cI have problems with eczema. What should I do?\u201d", "answer": "— Use cortisone." } },
        { "type": "qa", "settings": { "question": "\u201cI hate my sweaty gloves in summer. They keep splitting.\u201d", "answer": "— Buy cheaper ones." } }
      ]
    }
  ]
}
{% endschema %}
