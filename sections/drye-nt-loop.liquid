{{ 'drye-nt-loop.css' | asset_url | stylesheet_tag }}

<section
  class="dryeNEW-section drye-nt-loop"
  data-section-id="{{ section.id }}"
  data-drye-section
  data-section-name="advice-loop"
  data-section-type="drye-nt-loop"
>
  <div class="dryeNEW-container">

    <div class="drye-nt-loop__head">
      {%- if section.settings.chap_no != blank -%}
        <span class="drye-nt-loop__chapno">{{ section.settings.chap_no }}</span>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="drye-nt-loop__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="dryeNEW-h2 drye-nt-loop__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>

    <div class="drye-nt-loop__grid" aria-label="{{ section.settings.aria_label | default: 'Common advice nail techs hear' }}">
      <div class="drye-nt-loop__track">

        {%- comment -%} First pass — real content {%- endcomment -%}
        {%- for block in section.blocks -%}
          <div class="drye-nt-loop__item" {{ block.shopify_attributes }}>
            {%- if block.settings.avatar != blank -%}
              <img
                class="drye-nt-loop__avatar"
                src="{{ block.settings.avatar | image_url: width: 200 }}"
                width="200" height="200"
                alt=""
                loading="lazy">
            {%- endif -%}
            <p class="drye-nt-loop__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
            <p class="drye-nt-loop__advice">&mdash; {{ block.settings.advice }}</p>
          </div>
        {%- endfor -%}

        {%- comment -%} Second pass — duplicate for seamless marquee (aria-hidden) {%- endcomment -%}
        {%- for block in section.blocks -%}
          <div class="drye-nt-loop__item" aria-hidden="true">
            {%- if block.settings.avatar != blank -%}
              <img
                class="drye-nt-loop__avatar"
                src="{{ block.settings.avatar | image_url: width: 200 }}"
                width="200" height="200"
                alt=""
                loading="lazy">
            {%- endif -%}
            <p class="drye-nt-loop__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
            <p class="drye-nt-loop__advice">&mdash; {{ block.settings.advice }}</p>
          </div>
        {%- endfor -%}

      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "DRYE NT — Advice Loop",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    { "type": "text",     "id": "chap_no",    "label": "Chapter number",          "default": "03" },
    { "type": "text",     "id": "eyebrow",    "label": "Eyebrow",                 "default": "The never-ending loop" },
    { "type": "textarea", "id": "title",      "label": "Title",                   "default": "POV: You’re stuck in the nail tech advice loop." },
    { "type": "text",     "id": "aria_label", "label": "Accessible region label", "default": "Common advice nail techs hear" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Advice quote",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Avatar (silhouette)" },
        { "type": "textarea",     "id": "quote",  "label": "Nail tech quote" },
        { "type": "text",         "id": "advice", "label": "Advice given" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "DRYE NT — Advice Loop",
      "blocks": [
        { "type": "quote", "settings": { "quote": "am I doomed to this for the rest of my career?",          "advice": "Use thicker mils" }},
        { "type": "quote", "settings": { "quote": "I wore gloves even though I got a contact allergy every time", "advice": "Use Gloves in a Bottle" }},
        { "type": "quote", "settings": { "quote": "cotton liners make my hands sweaty after 30 min.",       "advice": "Double up" }},
        { "type": "quote", "settings": { "quote": "I hate my sweaty gloves in summer. They keep splitting.","advice": "Cut the fingertips off" }}
      ]
    }
  ]
}
{% endschema %}
