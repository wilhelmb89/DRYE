{{ 'section-drye-article-hero.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  DRYE Article Hero — editorial. Value-first: kicker -> Playfair headline -> deck
  (article excerpt) -> byline. No blue product bar, no product image. The featured
  image is rendered separately (drye-article-hero-image) below this.
{%- endcomment -%}

<section class="article-hero">
  <div class="article-hero-in">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="{{ blog.url }}">{{ blog.title }}</a>
      <span class="breadcrumb-sep">/</span>
      <span>{{ article.title | truncate: 48 }}</span>
    </nav>

    {% if article.tags.size > 0 %}
      <p class="article-kicker">{{ article.tags.first }}</p>
    {% endif %}

    <h1 class="article-h">{{ article.title }}</h1>

    {% if article.excerpt != blank %}
      <p class="article-deck">{{ article.excerpt | strip_html }}</p>
    {% endif %}

    <div class="article-byline">
      <span class="byline-by">By <strong>{{ section.settings.author | default: 'DRYE Insights' }}</strong></span>
      {% if section.settings.meta_read_time != blank %}
        <span class="byline-dot"></span>
        <span>{{ section.settings.meta_read_time }}</span>
      {% endif %}
      {% if section.settings.meta_location != blank %}
        <span class="byline-dot"></span>
        <span>{{ section.settings.meta_location }}</span>
      {% endif %}
      {% if section.settings.meta_study != blank %}
        <span class="byline-dot"></span>
        <span>{{ section.settings.meta_study }}</span>
      {% endif %}
      <span class="byline-dot"></span>
      <span>{{ article.published_at | date: "%B %-d, %Y" }}</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DRYE Article Hero",
  "tag": "section",
  "class": "section-drye-article-hero",
  "settings": [
    {
      "type": "text",
      "id": "author",
      "label": "Byline (author / desk)",
      "default": "DRYE Insights"
    },
    {
      "type": "text",
      "id": "meta_read_time",
      "label": "Read time",
      "default": "6 min read"
    },
    {
      "type": "text",
      "id": "meta_location",
      "label": "Byline detail — location (optional)",
      "default": "asd"
    },
    {
      "type": "text",
      "id": "meta_study",
      "label": "Byline detail — study / sources (optional)",
      "default": "asd"
    }
  ]
}
{% endschema %}