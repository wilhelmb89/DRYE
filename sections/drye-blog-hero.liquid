{{ 'section-drye-blog-hero.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  DRYE Blog Hero — editorial masthead + standfirst. No dark full-bleed hero;
  reads like a publication's front page, not a product landing section.
{%- endcomment -%}

<header class="blog-masthead">
  <div class="blog-masthead__row">
    <div class="blog-masthead__brand">
      <span class="blog-masthead__mark">DRYE</span>
      <span class="blog-masthead__div" aria-hidden="true"></span>
      <span class="blog-masthead__section">{{ section.settings.eyebrow | default: 'Insights' }}</span>
    </div>
    {% if section.settings.description != blank %}
      <p class="blog-masthead__meta">{{ section.settings.description | strip_html | truncatewords: 8 }}</p>
    {% endif %}
  </div>
</header>

<section class="blog-standfirst" id="drye-blog-hero-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="blog-standfirst__in">
    {% if section.settings.heading != blank or section.settings.heading_emphasis != blank %}
      <h1 class="blog-standfirst__h">
        {% if section.settings.heading != blank %}{{ section.settings.heading }}{% endif %}
        {% if section.settings.heading_emphasis != blank %}<em>{{ section.settings.heading_emphasis }}</em>{% endif %}
      </h1>
    {% endif %}
    {% if section.settings.description != blank %}
      <p class="blog-standfirst__p">{{ section.settings.description }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "DRYE Blog Hero",
  "tag": "section",
  "class": "section-drye-blog-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Masthead section label",
      "default": "Insights"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Evidence, not opinion."
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Heading emphasis",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Field studies, peer-reviewed science, and documented results from people who use DRYE in real conditions."
    }
  ],
  "presets": [
    {
      "name": "DRYE Blog Hero"
    }
  ]
}
{% endschema %}
