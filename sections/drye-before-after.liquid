{{ 'drye-before-after.css' | asset_url | stylesheet_tag }}

<section
  class="dryeNEW-section drye-ba-section"
  id="drye-before-after-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-drye-section
  data-section-name="before_after"
>
  <div class="dryeNEW-container">
    {% if section.settings.micro_label != blank %}
      <span class="dryeNEW-micro drye-ba-micro">
        {{ section.settings.micro_label }}
      </span>
    {% endif %}

    {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
      <h2 class="dryeNEW-h2 drye-ba-heading">
        {{ section.settings.heading_line_1 }}
        {% if section.settings.heading_line_2 != blank %}<br>{% endif %}
        {{ section.settings.heading_line_2 }}
      </h2>
    {% endif %}

    {% if section.settings.intro != blank %}
      <div class="dryeNEW-body drye-ba-intro">
        <p>{{ section.settings.intro }}</p>
      </div>
    {% endif %}

    {%- comment -%}
      Mobile: a scroll-snap rail, one card per swipe. Desktop: the same
      three-column grid as before. All of it is CSS — scroll-snap-type does the
      paging, so the browser owns the gesture and this rail cannot fight a
      vertical page scroll.

      role/aria-label + tabindex are what make a horizontal scroller reachable
      by keyboard; without tabindex the arrow keys do nothing here.
    {%- endcomment -%}
    <div
      class="drye-ba-grid"
      tabindex="0"
      role="region"
      aria-label="{{ section.settings.rail_label | default: 'Before and after cases' | escape }}"
    >
      {% for block in section.blocks %}
        {%- liquid
          assign before_label = block.settings.before_label | default: section.settings.before_label
          assign after_label = block.settings.after_label | default: section.settings.after_label
        -%}
        <article class="drye-ba-card" {{ block.shopify_attributes }}>
          <div class="drye-ba-images">
            <div class="drye-ba-image-wrap">
              {% if block.settings.before_image != blank %}
                {{
                  block.settings.before_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    class: 'drye-ba-image',
                    sizes: '(min-width: 768px) 30vw, 41vw',
                    alt: block.settings.before_alt | escape
                }}
              {% else %}
                <div class="drye-ba-placeholder drye-ba-placeholder--before">
                  <span>{{ before_label }}</span>
                </div>
              {% endif %}
              {% if before_label != blank %}
                <span class="dryeNEW-micro drye-ba-label">{{ before_label }}</span>
              {% endif %}
            </div>

            <div class="drye-ba-image-wrap">
              {% if block.settings.after_image != blank %}
                {{
                  block.settings.after_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    class: 'drye-ba-image',
                    sizes: '(min-width: 768px) 30vw, 41vw',
                    alt: block.settings.after_alt | escape
                }}
              {% else %}
                <div class="drye-ba-placeholder drye-ba-placeholder--after">
                  <span>{{ after_label }}</span>
                </div>
              {% endif %}
              {% if after_label != blank %}
                <span class="dryeNEW-micro drye-ba-label">{{ after_label }}</span>
              {% endif %}
            </div>

            <div class="drye-ba-divider" aria-hidden="true"></div>
          </div>

          <div class="drye-ba-body">
            {% if block.settings.timeline != blank %}
              <div class="dryeNEW-micro drye-ba-timeline">{{ block.settings.timeline }}</div>
            {% endif %}

            {% if block.settings.quote != blank %}
              <div class="dryeNEW-body drye-ba-quote">
                <p>{{ block.settings.quote }}</p>
              </div>
            {% endif %}

            {% if block.settings.attribution != blank %}
              <div class="dryeNEW-body--caption drye-ba-attribution">
                <p>{{ block.settings.attribution }}</p>
              </div>
            {% endif %}

            {% if block.settings.cta_label != blank %}
              <a class="drye-ba-cta" href="{{ block.settings.cta_url | default: '#offer' }}">
                {{ block.settings.cta_label }} <span aria-hidden="true">&rarr;</span>
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {%- comment -%}
      Mobile-only swipe cue. The .swipe-hint primitive lives in base.css — the
      same one used by the objections strip, the stories carousel and the B2B
      sections. Only shown when there is actually more than one card to reach.
    {%- endcomment -%}
    {% if section.settings.swipe_label != blank and section.blocks.size > 1 %}
      <div class="swipe-hint drye-ba-hint" aria-hidden="true">
        <span class="swipe-hint__label">{{ section.settings.swipe_label }}</span>
        <span class="swipe-hint__track"><i class="swipe-hint__dot"></i></span>
      </div>
    {% endif %}

    {% if section.settings.note != blank %}
      <div class="dryeNEW-body--caption drye-ba-note">
        <p>{{ section.settings.note }}</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "DRYE Before / After",
  "tag": "section",
  "class": "shopify-section-drye-before-after",
  "settings": [
    { "type": "text", "id": "micro_label", "label": "Micro label", "default": "Real Users — Real Results" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "Before and after." },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2", "default": "No filters. No staging." },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "These are unsolicited photos sent directly to us by users. We didn't ask for them. They sent them because the results were that visible." },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "paragraph",
      "content": "On phones the cards become a horizontal swipe rail — one card per swipe. Desktop stays a three-column grid."
    },
    { "type": "text", "id": "swipe_label", "label": "Swipe label", "default": "Swipe", "info": "Leave blank to hide the cue." },
    { "type": "text", "id": "rail_label", "label": "Screen-reader label for the rail", "default": "Before and after cases" },
    {
      "type": "header",
      "content": "Default image labels"
    },
    {
      "type": "paragraph",
      "content": "Used when a card has no label of its own. Dates are stronger than 'Before' and 'After' — a date is a fact, 'after' is a claim."
    },
    { "type": "text", "id": "before_label", "label": "Default left label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "Default right label", "default": "After" },
    {
      "type": "header",
      "content": "Footnote"
    },
    { "type": "textarea", "id": "note", "label": "Bottom note", "default": "Photos sent to us by users, unedited. Individual results vary — these are single cases, not typical outcomes." }
  ],
  "blocks": [
    {
      "type": "case",
      "name": "Before / after card",
      "settings": [
        { "type": "image_picker", "id": "before_image", "label": "Left image" },
        { "type": "text", "id": "before_alt", "label": "Left image alt text", "default": "Hand before regular use of the DRYE liner" },
        { "type": "text", "id": "before_label", "label": "Left label", "info": "Leave blank to use the section default. A date beats the word 'Before'." },
        { "type": "image_picker", "id": "after_image", "label": "Right image" },
        { "type": "text", "id": "after_alt", "label": "Right image alt text", "default": "Same hand after regular use of the DRYE liner" },
        { "type": "text", "id": "after_label", "label": "Right label", "info": "Leave blank to use the section default." },
        { "type": "text", "id": "timeline", "label": "Timeline", "default": "After 5 months" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "\"I had problems for years, and it just kept getting worse. I still moisturize sometimes — but my hands are honestly just normal now.\"" },
        { "type": "text", "id": "attribution", "label": "Attribution", "default": "— Jens Stålnacke, Mine Worker, Luleå" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Read the story" },
        { "type": "url", "id": "cta_url", "label": "CTA link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "DRYE Before / After",
      "blocks": [
        {
          "type": "case",
          "settings": {
            "before_label": "14 March",
            "after_label": "21 March",
            "timeline": "One week",
            "quote": "\"These gloves completely solved my contact dermatitis problems.\"",
            "attribution": "— Chris P., Fort Worth, Texas",
            "cta_label": "Read his story"
          }
        },
        {
          "type": "case",
          "settings": {
            "before_label": "Nov 2022",
            "after_label": "One season on",
            "timeline": "After one season",
            "quote": "\"Cracks all over my knuckles, redness and eczema. My hands stay drier, grip is better, skin holds up.\"",
            "attribution": "— Linnéa Pettersson Dove, SDHL Swedish Champion 2025, Frölunda HC",
            "cta_label": "Read her story"
          }
        },
        {
          "type": "case",
          "settings": {
            "before_label": "Month 1",
            "after_label": "Month 5",
            "timeline": "After 5 months",
            "quote": "\"Real skin problems started in 2017 – pain, open scars and wounds. Nothing worked for years.\"",
            "attribution": "— Jens Stålnacke, Mine Worker, Luleå",
            "cta_label": "Read his story"
          }
        }
      ]
    }
  ]
}
{% endschema %}
