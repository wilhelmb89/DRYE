{{ 'drye-nt-real-reviews.css' | asset_url | stylesheet_tag }}

<section
  class="drye-nt lp-block tp3"
  id="drye-nt-real-reviews-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-drye-section
  data-section-name="nt_real_reviews"
>
  <div class="lp-wrap">
    <div class="lp-narrow" style="text-align: center; margin-inline: auto">
      {%- if section.settings.heading != blank -%}<h2 class="lp-lead" style="text-align: center">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.trustpilot_logo != blank -%}
        {{ section.settings.trustpilot_logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: 'Trustpilot', class: 'tp3-logo' }}
      {%- endif -%}
    </div>

    <div class="tp3-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="tp3-card" {{ block.shopify_attributes }}>
            <div class="tp3-head">
              <div class="tp3-avatar" style="background: {{ block.settings.avatar_color | default: '#BFE9DD' }}">{{ block.settings.initials }}</div>
              <div><span class="tp3-name">{{ block.settings.name }}</span><span class="tp3-meta">{{ block.settings.meta }}</span></div>
            </div>
            <div class="tp3-stars" aria-hidden="true"><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span></div>
            {%- if block.settings.title != blank -%}<h3 class="tp3-title">{{ block.settings.title }}</h3>{%- endif -%}
            <p class="tp3-body" data-tp3-body>{{ block.settings.quote }}</p>
            <button type="button" class="tp3-more" data-tp3-toggle>Read more</button>
            {%- if block.settings.date != blank -%}<span class="tp3-date">{{ block.settings.date }}</span>{%- endif -%}
          </div>
        {%- elsif block.type == 'video_review' -%}
          {%- assign mg_url = block.settings.video_url | strip -%}
          {%- assign mg_id = '' -%}
          {%- if mg_url != blank -%}
            {%- if mg_url contains 'shorts/' -%}
              {%- assign mg_id = mg_url | split: 'shorts/' | last | split: '?' | first | split: '/' | first -%}
            {%- elsif mg_url contains 'youtu.be/' -%}
              {%- assign mg_id = mg_url | split: 'youtu.be/' | last | split: '?' | first | split: '/' | first -%}
            {%- elsif mg_url contains 'embed/' -%}
              {%- assign mg_id = mg_url | split: 'embed/' | last | split: '?' | first | split: '/' | first -%}
            {%- elsif mg_url contains 'v=' -%}
              {%- assign mg_id = mg_url | split: 'v=' | last | split: '&' | first -%}
            {%- else -%}
              {%- assign mg_id = mg_url | split: '/' | last | split: '?' | first -%}
            {%- endif -%}
          {%- endif -%}
          <div class="tp3-card tp3-card--video" {{ block.shopify_attributes }}>
            <div class="tp3-video"{% if mg_id != blank %} data-tp3-video="{{ mg_id }}"{% endif %}>
              {%- if mg_id != blank -%}
                <img class="tp3-video-thumb" src="https://i.ytimg.com/vi/{{ mg_id }}/hqdefault.jpg" alt="{{ block.settings.name | escape }} video review" loading="lazy" width="480" height="360">
                <div class="tp3-video-overlay" aria-hidden="true"></div>
                <button type="button" class="tp3-play" aria-label="{{ block.settings.video_play_label | default: 'Play video' }}">
                  <svg viewBox="0 0 24 24" width="20" height="20"><path d="M8 5v14l11-7z" fill="#ffffff"></path></svg>
                </button>
              {%- endif -%}
              <div class="tp3-video-cap">
                <div class="tp3-head" style="margin-bottom: 8px">
                  <div class="tp3-avatar" style="background: {{ block.settings.avatar_color | default: '#F7D2A8' }}">{{ block.settings.initials }}</div>
                  <div><span class="tp3-name">{{ block.settings.name }}</span><span class="tp3-meta">{{ block.settings.meta }}</span></div>
                </div>
                <div class="tp3-stars" aria-hidden="true"><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span></div>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('drye-nt-real-reviews-{{ section.id }}');
  if (!root) return;

  // Swipe hint: nudge the carousel once when it scrolls into view (mobile only).
  var grid = root.querySelector('.tp3-grid');
  if (grid) {
    var mqMobile = window.matchMedia('(max-width: 767px)');
    var mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var hinted = false;
    var nudge = function () {
      if (hinted || !mqMobile.matches || mqReduce.matches) return;
      hinted = true;
      try {
        grid.scrollBy({ left: 44, behavior: 'smooth' });
        setTimeout(function () { grid.scrollBy({ left: -44, behavior: 'smooth' }); }, 450);
        setTimeout(function () { grid.scrollBy({ left: 44, behavior: 'smooth' }); }, 950);
        setTimeout(function () { grid.scrollBy({ left: -44, behavior: 'smooth' }); }, 1400);
      } catch (e) {}
    };
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) { nudge(); io.disconnect(); }
      }, { threshold: 0.4 });
      io.observe(grid);
    } else {
      nudge();
    }
  }

  root.querySelectorAll('[data-tp3-toggle]').forEach(function (btn) {
    var body = btn.parentElement.querySelector('[data-tp3-body]');
    if (!body) return;
    btn.addEventListener('click', function () {
      var open = body.classList.toggle('tp3-body--open');
      btn.textContent = open ? 'Read less' : 'Read more';
    });
  });

  root.addEventListener('click', function (e) {
    var btn = e.target.closest('.tp3-play');
    if (!btn) return;
    var box = btn.closest('[data-tp3-video]');
    if (!box) return;
    var id = box.getAttribute('data-tp3-video');
    if (!id) return;
    var frame = document.createElement('div');
    frame.className = 'tp3-video-frame';
    frame.innerHTML =
      '<iframe src="https://www.youtube.com/embed/' + encodeURIComponent(id) +
      '?autoplay=1&rel=0&playsinline=1" title="Video" frameborder="0" ' +
      'allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>';
    box.appendChild(frame);
  });
})();
</script>

{% schema %}
{
  "name": "DRYE NT — Real reviews",
  "tag": "section",
  "class": "shopify-section-drye-nt-real-reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers are saying." },
    { "type": "image_picker", "id": "trustpilot_logo", "label": "Trustpilot logo" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review card",
      "settings": [
        { "type": "text", "id": "initials", "label": "Avatar initials", "default": "PN" },
        { "type": "color", "id": "avatar_color", "label": "Avatar color", "default": "#BFE9DD" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "meta", "label": "Meta line", "info": "e.g. \"US · 2 reviews\"" },
        { "type": "text", "id": "title", "label": "Review title" },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "date", "label": "Date label" }
      ]
    },
    {
      "type": "video_review",
      "name": "Video review card",
      "settings": [
        { "type": "text", "id": "video_url", "label": "YouTube link", "info": "Paste any YouTube link — Shorts, youtu.be or watch links all work. A thumbnail + play button appear; visitors click to load the video." },
        { "type": "text", "id": "video_play_label", "label": "Play button label (accessibility)", "default": "Play video" },
        { "type": "text", "id": "initials", "label": "Avatar initials", "default": "DF" },
        { "type": "color", "id": "avatar_color", "label": "Avatar color", "default": "#F7D2A8" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "meta", "label": "Meta line" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "DRYE NT — Real reviews",
      "blocks": [
        { "type": "review", "settings": { "initials": "PN", "avatar_color": "#BFE9DD", "name": "PN", "meta": "US · 2 reviews", "title": "Great liners that work!", "date": "Jun 15, 2025", "quote": "I have eczema and these liners have been the best things I bought for my hands." } },
        { "type": "video_review", "settings": { "initials": "DF", "avatar_color": "#F7D2A8", "name": "Debby Fields", "meta": "US · 3 reviews" } }
      ]
    }
  ]
}
{% endschema %}