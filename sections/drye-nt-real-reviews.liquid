{{ 'drye-nt-real-reviews.css' | asset_url | stylesheet_tag }}

<section
  class="drye-nt lp-block tp3"
  id="drye-nt-real-reviews-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-drye-section
  data-section-name="nt_real_reviews"
>
  <div class="lp-wrap">
    <div class="lp-narrow" style="text-align: center; margin-inline: auto">
      {%- if section.settings.heading != blank -%}<h2 class="lp-lead" style="text-align: center">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.trustpilot_logo != blank -%}
        {{ section.settings.trustpilot_logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: 'Trustpilot', class: 'tp3-logo' }}
      {%- endif -%}
    </div>

    <div class="tp3-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="tp3-card" {{ block.shopify_attributes }}>
            <div class="tp3-head">
              <div class="tp3-avatar" style="background: {{ block.settings.avatar_color | default: '#BFE9DD' }}">{{ block.settings.initials }}</div>
              <div><span class="tp3-name">{{ block.settings.name }}</span><span class="tp3-meta">{{ block.settings.meta }}</span></div>
            </div>
            <div class="tp3-stars" aria-hidden="true"><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span></div>
            {%- if block.settings.title != blank -%}<h3 class="tp3-title">{{ block.settings.title }}</h3>{%- endif -%}
            <p class="tp3-body" data-tp3-body>{{ block.settings.quote }}</p>
            <button type="button" class="tp3-more" data-tp3-toggle>Read more</button>
            {%- if block.settings.date != blank -%}<span class="tp3-date">{{ block.settings.date }}</span>{%- endif -%}
          </div>
        {%- elsif block.type == 'video_review' -%}
          <div class="tp3-card tp3-card--video" {{ block.shopify_attributes }}>
            <div class="tp3-video">
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '800x' }}
              {%- endif -%}
              <div class="tp3-video-cap">
                <div class="tp3-head" style="margin-bottom: 8px">
                  <div class="tp3-avatar" style="background: {{ block.settings.avatar_color | default: '#F7D2A8' }}">{{ block.settings.initials }}</div>
                  <div><span class="tp3-name">{{ block.settings.name }}</span><span class="tp3-meta">{{ block.settings.meta }}</span></div>
                </div>
                <div class="tp3-stars" aria-hidden="true"><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span></div>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('drye-nt-real-reviews-{{ section.id }}');
  if (!root) return;
  root.querySelectorAll('[data-tp3-toggle]').forEach(function (btn) {
    var body = btn.parentElement.querySelector('[data-tp3-body]');
    if (!body) return;
    btn.addEventListener('click', function () {
      var open = body.classList.toggle('tp3-body--open');
      btn.textContent = open ? 'Read less' : 'Read more';
    });
  });
})();
</script>

{% schema %}
{
  "name": "DRYE NT — Real reviews",
  "tag": "section",
  "class": "shopify-section-drye-nt-real-reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers are saying." },
    { "type": "image_picker", "id": "trustpilot_logo", "label": "Trustpilot logo" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review card",
      "settings": [
        { "type": "text", "id": "initials", "label": "Avatar initials", "default": "PN" },
        { "type": "color", "id": "avatar_color", "label": "Avatar color", "default": "#BFE9DD" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "meta", "label": "Meta line", "info": "e.g. \"US · 2 reviews\"" },
        { "type": "text", "id": "title", "label": "Review title" },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "date", "label": "Date label" }
      ]
    },
    {
      "type": "video_review",
      "name": "Video review card",
      "settings": [
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "text", "id": "initials", "label": "Avatar initials", "default": "DF" },
        { "type": "color", "id": "avatar_color", "label": "Avatar color", "default": "#F7D2A8" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "meta", "label": "Meta line" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "DRYE NT — Real reviews",
      "blocks": [
        { "type": "review", "settings": { "initials": "PN", "avatar_color": "#BFE9DD", "name": "PN", "meta": "US · 2 reviews", "title": "Great liners that work!", "date": "Jun 15, 2025", "quote": "I have eczema and these liners have been the best things I bought for my hands. I have to wear latex gloves all day for work. I'd wear the DRYE liners then the latex gloves on top. Every hour, I would change my gloves (and liners) and notice the sweat on my DRYE — but my hands remain dried. When my skin is dried and cracked, I would wear just the DRYE at home and my hands feel better. Thank you so much for making these! I have seven pairs to rotate. Have been wearing them for a few months now. Machine wash every other day (laid to dry under sunlight in between washes). Still great condition." } },
        { "type": "review", "settings": { "initials": "DF", "avatar_color": "#F7D2A8", "name": "Debby Fields", "meta": "US · 3 reviews", "title": "Incredible difference! Worth every penny!", "date": "Aug 17, 2025", "quote": "My son's hands were bright pink and raw with all of the skin peeling off from wearing work gloves. I researched the best solutions and DRYE liners were considered the best. Within a few days of wearing the liners, his hands were drastically improved. Within two weeks, they are completely healed and back to normal. I cannot believe the difference! I also bought a rack to dry the gloves and have now purchased multiple pairs to allow for more washing and rotation to prevent reoccurrence, but these liners made a tremendous difference! Additionally, I was unsure of the best size and customer service was prompt and amazingly helpful. I highly recommend! Worth every penny!" } },
        { "type": "review", "settings": { "initials": "JO", "avatar_color": "#F6C7DC", "name": "Jon", "meta": "GB · 1 review", "title": "Gloves have performed really very well so far", "date": "May 1, 2025", "quote": "Gloves have performed very well so far, excellent fit, quick delivery and they do as the site describes. They keep the sweat and some extra heat from my palms which are one of my triggers. I'd recommend if like me you've tried everything and it doesn't work — give these a try." } },
        { "type": "video_review", "settings": { "initials": "DF", "avatar_color": "#F7D2A8", "name": "Debby Fields", "meta": "US · 3 reviews" } }
      ]
    }
  ]
}
{% endschema %}