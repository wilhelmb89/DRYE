{{ 'section-drye-article-body.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  DRYE Article Body — editorial, single column. The sidebar sell box is removed;
  conversion is a single discreet "Editor's note" text link at the end. Styling
  targets .article-body + the content's own classes/elements (h2, p, .article-lead,
  .data-table, blockquote, img...), so every post inherits the look — no per-post
  markup rewrite needed for the design.
{%- endcomment -%}

<div class="article-wrap">
  <article class="article-body">
    {{ article.content }}

    {%- if section.settings.ednote_text != blank -%}
      <aside class="article-ednote">
        {%- if section.settings.ednote_label != blank -%}
          <p class="article-ednote__label">{{ section.settings.ednote_label }}</p>
        {%- endif -%}
        <p class="article-ednote__body">{{ section.settings.ednote_text }}
          {%- if section.settings.ednote_link_label != blank -%}
            <a href="{{ section.settings.ednote_link | default: '#' }}">{{ section.settings.ednote_link_label }}</a>
          {%- endif -%}
        </p>
      </aside>
    {%- endif -%}

    {% if article.tags.size > 0 %}
      <div class="article-tags">
        {% for tag in article.tags %}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="tag">{{ tag }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </article>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  "image": [
    {{ article.image | image_url: width: 1200 | prepend: "https:" | json }}
  ],
  "description": {{ article.excerpt | default: article.content | strip_html | truncate: 160 | json }},
  "datePublished": "{{ article.published_at | date: "%Y-%m-%d" }}",
  "dateModified": "{{ article.updated_at | date: "%Y-%m-%d" }}",
  "author": {
    "@type": "Organization",
    "name": "DRYE"
  },
  "publisher": {
    "@type": "Organization",
    "name": "DRYE",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.dryeliner.com/cdn/shop/files/DRYE-04.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ canonical_url | json }}
  }
}
</script>

{% schema %}
{
  "name": "DRYE Article Body",
  "tag": "section",
  "class": "section-drye-article-body",
  "settings": [
    {
      "type": "header",
      "content": "Editor's note"
    },
    {
      "type": "text",
      "id": "ednote_label",
      "label": "Label",
      "default": "Editor's note"
    },
    {
      "type": "textarea",
      "id": "ednote_text",
      "label": "Text",
      "default": "DRYE, which publishes Insights, makes a thin under-glove liner built to route sweat off the skin rather than absorb it."
    },
    {
      "type": "text",
      "id": "ednote_link_label",
      "label": "Link label",
      "default": "See how it works →"
    },
    {
      "type": "url",
      "id": "ednote_link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "DRYE Article Body"
    }
  ]
}
{% endschema %}