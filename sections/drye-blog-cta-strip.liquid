{{ 'drye-blog-cta-strip.css' | asset_url | stylesheet_tag }}

<section
  class="cta-strip{% if section.settings.heading_size == 'large' %} cta-strip--lg{% endif %}"
  id="cta-strip-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-drye-section
  data-section-name="blog_cta_strip"
>
  <div class="cta-strip__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="cta-strip__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank or section.settings.heading_emphasis != blank -%}
      <h2 class="cta-strip__heading">
        {%- if section.settings.heading != blank -%}{{ section.settings.heading }} {% endif -%}
        {%- if section.settings.heading_emphasis != blank -%}
          <span class="dryeNEW-editorial">{{ section.settings.heading_emphasis }}</span>
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="cta-strip__sub">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
      <div class="cta-strip__actions">
        <div class="dryeNEW-btn-row">
          {%- if section.settings.primary_label != blank -%}
            <a href="{{ section.settings.primary_url | default: '#' }}" class="dryeNEW-btn dryeNEW-btn--primary dryeNEW-btn--block">
              {{ section.settings.primary_label }} <span aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a href="{{ section.settings.secondary_url | default: '#' }}" class="dryeNEW-btn dryeNEW-btn--secondary dryeNEW-btn--block">
              {{ section.settings.secondary_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "DRYE Blog CTA Strip",
  "tag": "section",
  "class": "shopify-section-cta-strip",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "You've read the evidence." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Now try it." },
    { "type": "text", "id": "heading_emphasis", "label": "Heading emphasis (italic)", "default": "30 days. Full refund if it doesn't work." },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "compact",
      "options": [
        { "value": "compact", "label": "Compact (21px)" },
        { "value": "large", "label": "Section headline (31 / 40px)" }
      ] },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "If the physics don't change your shift — we'll return every dollar. No forms. No questions." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Order DRYE Liners" },
    { "type": "url", "id": "primary_url", "label": "Primary button URL" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "See the Research" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button URL" }
  ],
  "presets": [{ "name": "DRYE Blog CTA Strip" }]
}
{% endschema %}
