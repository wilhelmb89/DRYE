{{ 'drye-nt-desk.css' | asset_url | stylesheet_tag }}

<section
  class="drye-nt lp-block drye-nt-desk"
  id="drye-nt-desk-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-drye-section
  data-section-name="nt_desk"
>
  <div class="lp-wrap">
    <div class="lp-narrow">
      {%- if section.settings.chapter != blank -%}
        <span class="chapno">{{ section.settings.chapter }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lp-lead">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="ugc-scroll">
      {%- if section.blocks.size > 3 -%}
        <div class="ugc-nav" data-ugc-nav>
          <button
            type="button"
            class="ugc-arrow ugc-arrow--prev is-off"
            data-ugc-prev
            aria-label="{{ section.settings.prev_label | default: 'Previous photos' | escape }}"
          >
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.5 4 L6.5 10 L12.5 16"></path></svg>
          </button>

          <button
            type="button"
            class="ugc-arrow ugc-arrow--next"
            data-ugc-next
            aria-label="{{ section.settings.next_label | default: 'More photos' | escape }}"
          >
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.5 4 L13.5 10 L7.5 16"></path></svg>
          </button>
        </div>
      {%- endif -%}

      <div class="ugc-row" data-ugc-row>
        {%- for block in section.blocks -%}
          <figure {{ block.shopify_attributes }}>
            <div class="ugc-img">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag:
                   loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 760px) 33vw, 72vw',
                   alt: block.settings.image_alt | escape }}
              {%- endif -%}
            </div>
            {%- if block.settings.caption != blank -%}
              <figcaption class="ugc-cap">{{ block.settings.caption }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="swipe-hint" data-ugc-hint aria-hidden="true">
        <span class="swipe-hint__label">{{ section.settings.swipe_label }}</span>
        <span class="swipe-hint__track"><i class="swipe-hint__dot"></i></span>
      </div>
    {%- endif -%}

    {%- if section.settings.keep_label != blank and section.settings.keep_target != blank -%}
      <div class="keep-row">
        <a class="keep" href="{{ section.settings.keep_target }}">{{ section.settings.keep_label }}<svg viewBox="0 0 16 20" width="14" height="17" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 1 V16"></path><path d="M2 10.5 L8 17 L14 10.5"></path></svg></a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('drye-nt-desk-{{ section.id }}');
    if (!section) return;

    const row = section.querySelector('[data-ugc-row]');
    if (!row) return;

    const nav = section.querySelector('[data-ugc-nav]');
    const prev = nav && nav.querySelector('[data-ugc-prev]');
    const next = nav && nav.querySelector('[data-ugc-next]');
    const hint = section.querySelector('[data-ugc-hint]');

    /* One panel + gap = one step. Desktop advances a whole page of panels. */
    const step = () => {
      const fig = row.querySelector('figure');
      const gap = parseFloat(getComputedStyle(row).columnGap) || 0;
      return fig ? fig.getBoundingClientRect().width + gap : row.clientWidth * 0.8;
    };

    const update = () => {
      const max = row.scrollWidth - row.clientWidth;
      const scrollable = max > 8;

      if (prev) prev.classList.toggle('is-off', !scrollable || row.scrollLeft <= 8);
      if (next) next.classList.toggle('is-off', !scrollable || row.scrollLeft >= max - 8);
      if (hint && (!scrollable || row.scrollLeft > 16)) hint.classList.add('is-hidden');
    };

    const move = (dir) => {
      const s = step();
      const perPage = Math.max(1, Math.floor(row.clientWidth / s));
      row.scrollBy({ left: s * perPage * dir, behavior: 'smooth' });
    };

    if (prev) prev.addEventListener('click', () => move(-1));
    if (next) next.addEventListener('click', () => move(1));

    row.addEventListener('scroll', update, { passive: true });
    row.addEventListener('touchstart', () => hint && hint.classList.add('is-hidden'), { passive: true });
    window.addEventListener('resize', update);
    window.addEventListener('load', update);

    /* Images/blocks change size and count in the theme editor — re-measure. */
    if (window.ResizeObserver) new ResizeObserver(update).observe(row);

    document.addEventListener('shopify:section:load', (event) => {
      if (event.target === section || section.contains(event.target)) update();
    });

    update();
  })();
</script>

{% schema %}
{
  "name": "DRYE NT — At the desk",
  "tag": "section",
  "class": "shopify-section-drye-nt-desk",
  "settings": [
    { "type": "text", "id": "chapter", "label": "Chapter number", "default": "01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This is what it looks like at the desk." },
    { "type": "text", "id": "swipe_label", "label": "Swipe hint label (mobile)", "default": "Swipa" },
    { "type": "text", "id": "prev_label", "label": "Arrow label — previous (screen readers)", "default": "Previous photos" },
    { "type": "text", "id": "next_label", "label": "Arrow label — next (screen readers)", "default": "More photos" },
    { "type": "text", "id": "keep_label", "label": "Keep-reading label", "default": "Keep reading" },
    { "type": "text", "id": "keep_target", "label": "Keep-reading anchor", "default": "#drye-nt-trapped", "info": "Anchor id of the next section." }
  ],
  "blocks": [
    {
      "type": "shot",
      "name": "UGC card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (4:5)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Nail tech at work" },
        { "type": "textarea", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "DRYE NT — At the desk",
      "blocks": [
        { "type": "shot", "settings": { "caption": "\"By client four, my gloves normally feel soaked.\"", "image_alt": "Nail tech changing a nitrile glove between clients" } },
        { "type": "shot", "settings": { "caption": "\"I can change nitrile gloves without fighting wet hands.\"", "image_alt": "Her hands after several clients, gloves off" } },
        { "type": "shot", "settings": { "caption": "\"Thin enough to work in.\"", "image_alt": "DRYE under the glove during real work at the desk" } },
        { "type": "shot", "settings": { "caption": "\"Four clients in and still dry.\"", "image_alt": "Gloves off between clients, DRYE liner still on" } },
        { "type": "shot", "settings": { "caption": "\"No more wet hands at the end of the day.\"", "image_alt": "Close-up of hands mid-treatment" } }
      ]
    }
  ]
}
{% endschema %}
