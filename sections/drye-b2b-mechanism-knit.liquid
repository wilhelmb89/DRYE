{{ 'drye-b2b-mechanism.css' | asset_url | stylesheet_tag }}

<section class="drye-b2b sec" id="{{ section.settings.anchor_id | default: 'knit' }}">
  {%- if section.settings.eyebrow != blank -%}
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
  {%- endif -%}

  <div class="split-layout">
    <div class="split-copy">
      <h2 class="h2 h2--display" style="text-transform:none">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="body-mute" style="margin-top:12px">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    <div class="split-visual">
      <div class="constr-wrap">
        <svg viewBox="0 0 260 216" width="100%" style="display:block" aria-label="Plated knit construction routing moisture from the skin-facing side to the outer receiving side">
              <defs>
                <clipPath id="drye-slab-{{ section.id }}"><rect x="26" y="26" width="208" height="150" rx="8"></rect></clipPath>
                <linearGradient id="drye-yarn-{{ section.id }}" gradientUnits="userSpaceOnUse" x1="0" y1="176" x2="0" y2="26">
                  <stop offset="0" stop-color="var(--ink)"></stop><stop offset="1" stop-color="var(--ink-3)"></stop>
                </linearGradient>
              </defs>
              <text x="26" y="17" font-family="'DM Sans',sans-serif" font-size="9.5" font-weight="700" letter-spacing="0.1em" fill="var(--ink-3)">OUTER &middot; LYOCELL</text>
              <g clip-path="url(#drye-slab-{{ section.id }})">
                <rect x="26" y="26" width="208" height="150" fill="var(--paper-raised)"></rect>
                <rect x="26" y="26" width="208" height="26" fill="var(--paper-sunken)"></rect>
                <rect x="26" y="150" width="208" height="26" fill="var(--ink)"></rect>
                <rect x="37" y="70" width="18" height="56" rx="9" fill="none" stroke="url(#drye-yarn-{{ section.id }})" stroke-width="1.7" opacity="0.75"></rect>
                <rect x="63" y="83" width="18" height="56" rx="9" fill="none" stroke="url(#drye-yarn-{{ section.id }})" stroke-width="1.7" opacity="0.75"></rect>
                <rect x="89" y="70" width="18" height="56" rx="9" fill="none" stroke="url(#drye-yarn-{{ section.id }})" stroke-width="1.7" opacity="0.75"></rect>
                <rect x="115" y="83" width="18" height="56" rx="9" fill="none" stroke="url(#drye-yarn-{{ section.id }})" stroke-width="1.7" opacity="0.75"></rect>
                <rect x="141" y="70" width="18" height="56" rx="9" fill="none" stroke="url(#drye-yarn-{{ section.id }})" stroke-width="1.7" opacity="0.75"></rect>
                <rect x="167" y="83" width="18" height="56" rx="9" fill="none" stroke="url(#drye-yarn-{{ section.id }})" stroke-width="1.7" opacity="0.75"></rect>
                <rect x="193" y="70" width="18" height="56" rx="9" fill="none" stroke="url(#drye-yarn-{{ section.id }})" stroke-width="1.7" opacity="0.75"></rect>
              </g>
              <rect x="26" y="26" width="208" height="150" rx="8" fill="none" stroke="var(--ink)" stroke-width="1.4"></rect>
              <g>
                <circle cx="78" cy="162" r="2.2" fill="var(--teal)"></circle>
                <line x1="78" y1="156" x2="78" y2="51" stroke="var(--teal)" stroke-width="2.8" stroke-linecap="round"></line>
                <polygon points="78,40 71.5,55 84.5,55" fill="var(--teal)"></polygon>
                <path d="M61 37 Q78 28 95 37" fill="none" stroke="var(--teal)" stroke-width="1.3" stroke-linecap="round" opacity="0.7"></path>
              </g>
              <g>
                <circle cx="130" cy="162" r="2.2" fill="var(--teal)"></circle>
                <line x1="130" y1="156" x2="130" y2="51" stroke="var(--teal)" stroke-width="2.8" stroke-linecap="round"></line>
                <polygon points="130,40 123.5,55 136.5,55" fill="var(--teal)"></polygon>
                <path d="M113 37 Q130 28 147 37" fill="none" stroke="var(--teal)" stroke-width="1.3" stroke-linecap="round" opacity="0.7"></path>
              </g>
              <g>
                <circle cx="182" cy="162" r="2.2" fill="var(--teal)"></circle>
                <line x1="182" y1="156" x2="182" y2="51" stroke="var(--teal)" stroke-width="2.8" stroke-linecap="round"></line>
                <polygon points="182,40 175.5,55 188.5,55" fill="var(--teal)"></polygon>
                <path d="M165 37 Q182 28 199 37" fill="none" stroke="var(--teal)" stroke-width="1.3" stroke-linecap="round" opacity="0.7"></path>
              </g>
              <text x="26" y="194" font-family="'DM Sans',sans-serif" font-size="9.5" font-weight="700" letter-spacing="0.1em" fill="var(--ink)">SKIN SIDE &middot; POLYPROPYLENE</text>
              <text x="26" y="209" font-family="'DM Sans',sans-serif" font-size="9.5" fill="var(--ink-3)">Unitary plated knit &mdash; no bonded layers</text>
            </svg>
        {%- if section.settings.caption != blank -%}
          <p class="constr-caption">{{ section.settings.caption | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "drye-B2B Mech 2",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "knit" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Moisture routing in sealed environments" },
    { "type": "html", "id": "heading", "label": "Headline", "default": "Moisture routing in sealed environments" },
    { "type": "html", "id": "body", "label": "Body", "default": "Low-regain PP on the skin side, lyocell on the outer side — one unitary plated knit, no bonded layers." },
    { "type": "text", "id": "caption", "label": "Diagram caption", "default": "Directional moisture routing" }
  ],
  "presets": [{ "name": "drye-B2B Mech 2" }]
}
{% endschema %}
