{{ 'base.css' | asset_url | stylesheet_tag }}

{{ 'drye-hockey-lp.js' | asset_url | script_tag }}
{{ 'drye-hockey-parent-stories.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Verified parent stories. One slide per block. Quotes are verbatim with written
  permission on file — never paraphrase them into DRYE's own voice.
  The pendulum lives in its own section (drye-hockey-pendulum) so this one owns
  nothing but the carousel.
{%- endcomment -%}

<section class="dryeNEW-section drye-hockey-stories" id="{{ section.settings.anchor_id | default: 'parent-stories' }}" data-section-id="{{ section.id }}" data-drye-section="hockey-stories">
  <div class="dryeNEW-container">
    <div class="drye-hockey-stories__wrap" data-drye-carousel>
      <div class="drye-hockey-stories__view">
        <div class="drye-hockey-stories__track" data-drye-carousel-track>
          {%- for block in section.blocks -%}
            <div class="drye-hockey-stories__slide" {{ block.shopify_attributes }}>
              <div class="drye-hockey-stories__copy">
                {%- if block.settings.when != blank -%}
                  <span class="dryeNEW-micro drye-hockey-stories__when">{{ block.settings.when | escape }}</span>
                {%- endif -%}
                <h2 class="dryeNEW-h2 drye-hockey-stories__head">{{ block.settings.head }}</h2>
                {%- if block.settings.body != blank -%}
                  <div class="dryeNEW-body drye-hockey-stories__body">{{ block.settings.body }}</div>
                {%- endif -%}
                {%- if block.settings.punch != blank -%}
                  <figure class="drye-hockey-stories__card">
                    <blockquote class="dryeNEW-h3 drye-hockey-stories__punch">{{ block.settings.punch }}</blockquote>
                    <figcaption class="dryeNEW-body--caption drye-hockey-stories__who">{{ block.settings.who | escape }}</figcaption>
                  </figure>
                {%- endif -%}
              </div>

              <div class="drye-hockey-stories__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 460px, 100vw', alt: block.settings.image_alt }}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <button type="button" class="dryeNEW-nav dryeNEW-nav--prev" data-drye-carousel-prev aria-label="Previous story">&larr;</button>
      <button type="button" class="dryeNEW-nav dryeNEW-nav--next" data-drye-carousel-next aria-label="Next story">&rarr;</button>
    </div>

    {% render 'drye-hockey-swipe-hint' %}
  </div>
</section>

{% schema %}
{
  "name": "drye-Hockey Parents",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "parent-stories" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        { "type": "text", "id": "when", "label": "Eyebrow" },
        { "type": "html", "id": "head", "label": "Headline (their quote)" },
        { "type": "richtext", "id": "body", "label": "Body (their words)" },
        { "type": "text", "id": "punch", "label": "Card quote" },
        { "type": "text", "id": "who", "label": "Attribution" },
        { "type": "image_picker", "id": "image", "label": "Photo (4:3)" },
        { "type": "text", "id": "image_alt", "label": "Photo alt" }
      ]
    }
  ],
  "presets": [{ "name": "drye-Hockey Parents" }]
}
{% endschema %}