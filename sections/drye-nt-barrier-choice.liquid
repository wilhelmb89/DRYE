{{ 'drye-nt-base.css' | asset_url | stylesheet_tag }}
{{ 'drye-nt-barrier-choice.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  DRYE NT — Barrier choice
  Split CTA ("My skin feels fine" / "My skin is already irritated") drives:
   1. which stylised curve is shown (gentle → crosses at day 14, or steep → crosses at day 3)
   2. which result track unfolds under the chart
   3. a dashed drop-line that grows from the bar up to that day on the axis (1.1s after the click)
  All three curves are inline in the SVG and cross-faded with CSS — no JS drawing.
{%- endcomment -%}

<section
  class="drye-nt lp-block drye-nt-barrier-choice"
  id="drye-nt-barrier-choice-{{ section.id }}"
  style="background: var(--deep); border-top: 1px solid rgba(255,255,255,0.12)"
  data-section-id="{{ section.id }}"
  data-drye-section
  data-section-name="nt_barrier_choice"
>
  <div class="lp-wrap">
    <div class="bch" data-bch>
      {%- if section.settings.chapter != blank -%}
        <span class="bch-chap">{{ section.settings.chapter }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="bch-h1">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="bch-pick" role="group" aria-label="{{ section.settings.pick_label | escape }}">
        <button type="button" class="bch-btn" data-bch-pick="healthy" aria-pressed="true">
          {{ section.settings.btn_healthy }} <span aria-hidden="true">&rarr;</span>
        </button>
        <button type="button" class="bch-btn" data-bch-pick="damaged" aria-pressed="false">
          {{ section.settings.btn_damaged }} <span aria-hidden="true">&rarr;</span>
        </button>
      </div>

      {%- if section.settings.exposure != blank -%}
        <p class="bch-exposure">{{ section.settings.exposure }}</p>
      {%- endif -%}

      <div class="bch-plot">
        <span class="bch-y" style="top: 13.4%">100%</span>
        <span class="bch-y" style="top: 53%">50%</span>
        <span class="bch-y" style="top: 92.6%">0%</span>
        {%- if section.settings.risk_label != blank -%}
          <span class="bch-mz">{{ section.settings.risk_label }}</span>
        {%- endif -%}

        <svg class="bch-svg" viewBox="40 40 428 108" role="img" aria-label="{{ section.settings.chart_alt | escape }}">
          <defs>
            <clipPath id="bchWipe-{{ section.id }}"><rect class="g-wipe" x="40" y="0" width="430" height="160"></rect></clipPath>

            <linearGradient id="bchStrokeN-{{ section.id }}" x1="40" y1="0" x2="468" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0.50" stop-color="#ffffff"></stop><stop offset="0.66" stop-color="#EF4444"></stop><stop offset="1" stop-color="#EF4444"></stop>
            </linearGradient>
            <linearGradient id="bchFillN-{{ section.id }}" x1="40" y1="0" x2="468" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0.50" stop-color="rgba(255,255,255,0.13)"></stop><stop offset="0.66" stop-color="rgba(239,68,68,0.26)"></stop><stop offset="1" stop-color="rgba(239,68,68,0.26)"></stop>
            </linearGradient>

            <linearGradient id="bchStrokeH-{{ section.id }}" x1="40" y1="0" x2="468" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0.78" stop-color="#ffffff"></stop><stop offset="0.90" stop-color="#EF4444"></stop><stop offset="1" stop-color="#EF4444"></stop>
            </linearGradient>
            <linearGradient id="bchFillH-{{ section.id }}" x1="40" y1="0" x2="468" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0.78" stop-color="rgba(255,255,255,0.12)"></stop><stop offset="0.90" stop-color="rgba(239,68,68,0.24)"></stop><stop offset="1" stop-color="rgba(239,68,68,0.24)"></stop>
            </linearGradient>

            <linearGradient id="bchStrokeI-{{ section.id }}" x1="40" y1="0" x2="468" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0.14" stop-color="#ffffff"></stop><stop offset="0.26" stop-color="#EF4444"></stop><stop offset="1" stop-color="#EF4444"></stop>
            </linearGradient>
            <linearGradient id="bchFillI-{{ section.id }}" x1="40" y1="0" x2="468" y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0.14" stop-color="rgba(255,255,255,0.12)"></stop><stop offset="0.26" stop-color="rgba(239,68,68,0.26)"></stop><stop offset="1" stop-color="rgba(239,68,68,0.26)"></stop>
            </linearGradient>
          </defs>

          <rect x="40" y="47" width="428" height="34.5" fill="rgba(239,68,68,0.10)"></rect>
          <path d="M40 81.5 L468 81.5" stroke="rgba(239,68,68,0.42)" stroke-width="0.85" stroke-dasharray="3 5"></path>
          <g stroke="rgba(255,255,255,0.085)" stroke-width="0.75" stroke-dasharray="2 5"><path d="M40 54.5 L468 54.5"></path><path d="M40 97.25 L468 97.25"></path></g>
          <path d="M40 140 L468 140" stroke="rgba(255,255,255,0.16)" stroke-width="0.85"></path>
          <g stroke="rgba(255,255,255,0.075)" stroke-width="0.75" stroke-dasharray="2 5"><path d="M254 47 L254 140"></path><path d="M361 47 L361 140"></path></g>
          <g stroke="rgba(255,255,255,0.2)" stroke-width="0.85" stroke-dasharray="3 5"><path d="M147 44 L147 140"></path><path d="M417 44 L417 140"></path></g>

          <g clip-path="url(#bchWipe-{{ section.id }})">
            <!-- neutral (nothing picked) -->
            <g class="bch-curve bch-curve--n">
              <path d="M40 140 L88 113.96 L143 107.45 L149 115.82 L198 102.8 L253 95.36 L259 104.66 L308 87.92 L360 82.34 L366 90.71 L414 73.04 L468 65.6 L468 140 L40 140 Z" fill="url(#bchFillN-{{ section.id }})"></path>
              <path d="M40 140 L88 113.96 L143 107.45 L149 115.82 L198 102.8 L253 95.36 L259 104.66 L308 87.92 L360 82.34 L366 90.71 L414 73.04 L468 65.6" fill="none" stroke="url(#bchStrokeN-{{ section.id }})" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></path>
            </g>

            <!-- healthy: gentle, crosses the band at day 14 -->
            <g class="bch-curve bch-curve--h">
              <path d="M40 137.21 L88 128.84 L143 124.19 L149 128.84 L198 121.4 L253 114.89 L259 120.47 L308 109.31 L360 98.15 L366 104.66 L417 81.5 L468 76.82 L468 140 L40 140 Z" fill="url(#bchFillH-{{ section.id }})"></path>
              <path d="M40 137.21 L88 128.84 L143 124.19 L149 128.84 L198 121.4 L253 114.89 L259 120.47 L308 109.31 L360 98.15 L366 104.66 L417 81.5 L468 76.82" fill="none" stroke="url(#bchStrokeH-{{ section.id }})" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></path>
              <circle cx="417" cy="81.5" r="4" fill="#EF4444"></circle>
            </g>

            <!-- already irritated: steep, crosses the band at day 3 -->
            <g class="bch-curve bch-curve--i">
              <path d="M40 134.42 L88 113.96 L147 81.5 L153 88.06 L198 74.94 L253 68.38 L259 74.06 L308 62.75 L360 56.19 L417 52.47 L468 47.96 L468 140 L40 140 Z" fill="url(#bchFillI-{{ section.id }})"></path>
              <path d="M40 134.42 L88 113.96 L147 81.5 L153 88.06 L198 74.94 L253 68.38 L259 74.06 L308 62.75 L360 56.19 L417 52.47 L468 47.96" fill="none" stroke="url(#bchStrokeI-{{ section.id }})" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></path>
              <circle cx="147" cy="81.5" r="4" fill="#EF4444"></circle>
            </g>
          </g>
        </svg>
      </div>

      <div class="bch-days">
        <span class="is-first" style="left: var(--x-d1)"><i></i>{{ section.settings.day_1 }}</span>
        <span style="left: var(--x-d3)"><i></i>{{ section.settings.day_2 }}</span>
        <span style="left: var(--x-d7)"><i></i>{{ section.settings.day_3 }}</span>
        <span class="is-last" style="left: var(--x-d14)"><i></i>{{ section.settings.day_4 }}</span>
      </div>

      <div class="bch-tracks">
        <div class="bch-track bch-track--healthy">
          <div class="bch-track-in">
            <p class="bch-aud">{{ section.settings.aud_healthy }}</p>
            <div class="bch-rail">
              <span class="bch-drop" style="left: var(--x-d3)"></span>
              <span class="bch-drop bch-drop--red" style="left: var(--x-d14)"></span>
              <span class="bch-flag" style="left: var(--x-d3)">
                <b>{{ section.settings.healthy_d3 }}<em>{{ section.settings.day_2 }}</em></b><i></i>
              </span>
              <span class="bch-flag bch-flag--red bch-flag--end" style="left: var(--x-d14)">
                <b>{{ section.settings.healthy_d14 }}<em>{{ section.settings.day_4 }}</em></b><i></i>
              </span>
              <span class="bch-bar"><i style="left: 66%"></i></span>
            </div>
            <div class="bch-card">
              <p class="bch-card-aud">{{ section.settings.aud_healthy }}</p>
              <div class="bch-card-track">
                <span class="bch-card-flag" style="left: 66%">
                  <b>{{ section.settings.day_4 }}</b><i></i>
                </span>
                <span class="bch-card-bar"><i style="left: 66%"></i></span>
              </div>
              <ul class="bch-card-rows">
                <li><b>{{ section.settings.day_2 }}</b><span>{{ section.settings.healthy_d3 }}</span></li>
                <li class="is-red"><b>{{ section.settings.day_4 }}</b><span>{{ section.settings.healthy_d14 }}</span></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="bch-track bch-track--damaged">
          <div class="bch-track-in">
            <p class="bch-aud">{{ section.settings.aud_damaged }}</p>
            <div class="bch-rail">
              <span class="bch-drop bch-drop--red" style="left: var(--x-d3)"></span>
              <span class="bch-flag bch-flag--red" style="left: var(--x-d3)">
                <b>{{ section.settings.damaged_d3 }}<em>{{ section.settings.day_2 }}</em></b><i></i>
              </span>
              <span class="bch-bar"><i style="left: 25%"></i></span>
            </div>
            <div class="bch-card bch-card--alert">
              <p class="bch-card-aud">{{ section.settings.aud_damaged }}</p>
              <div class="bch-card-track">
                <span class="bch-card-flag is-red" style="left: 25%">
                  <b>{{ section.settings.day_2 }}</b><i></i>
                </span>
                <span class="bch-card-bar"><i style="left: 25%"></i></span>
              </div>
              <ul class="bch-card-rows">
                <li class="is-red"><b>{{ section.settings.day_2 }}</b><span>{{ section.settings.damaged_d3 }}</span></li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      {%- if section.settings.source != blank -%}
        <p class="bch-note">{{ section.settings.source }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('#drye-nt-barrier-choice-{{ section.id }} [data-bch]');
    if (!root || root.dataset.bchReady) return;
    root.dataset.bchReady = '1';
    var timer;
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-bch-pick]');
      if (!btn) return;
      root.querySelectorAll('[data-bch-pick]').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b === btn));
      });
      root.dataset.pick = btn.dataset.bchPick;
      root.classList.remove('is-marked');
      clearTimeout(timer);
      timer = setTimeout(function () { root.classList.add('is-marked'); }, 1100);
    });
  })();
</script>

{% schema %}
{
  "name": "DRYE NT — Barrier choice",
  "tag": "section",
  "class": "shopify-section-drye-nt-barrier-choice",
  "settings": [
    { "type": "text", "id": "chapter", "label": "Chapter number", "default": "04" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Why your skin and nails get worse inside gloves over time." },
    { "type": "header", "content": "Choice buttons" },
    { "type": "text", "id": "pick_label", "label": "Group aria-label", "default": "Choose your starting point" },
    { "type": "text", "id": "btn_healthy", "label": "Button 1", "default": "My skin feels fine" },
    { "type": "text", "id": "btn_damaged", "label": "Button 2", "default": "My skin is already irritated" },
    { "type": "text", "id": "exposure", "label": "Exposure note", "default": "Under glove 6 hours/day" },
    { "type": "header", "content": "Chart" },
    { "type": "text", "id": "risk_label", "label": "Risk band label", "default": "Maceration risk rises" },
    { "type": "text", "id": "chart_alt", "label": "Chart alt text", "default": "Stylised overhydration in the skin across two weeks of daily glove occlusion" },
    { "type": "text", "id": "day_1", "label": "Day label 1", "default": "Day 1" },
    { "type": "text", "id": "day_2", "label": "Day label 2", "default": "Day 3" },
    { "type": "text", "id": "day_3", "label": "Day label 3", "default": "Day 7" },
    { "type": "text", "id": "day_4", "label": "Day label 4", "default": "Day 14" },
    { "type": "header", "content": "Tracks" },
    { "type": "text", "id": "aud_healthy", "label": "Track 1 title", "default": "Healthy skin" },
    { "type": "text", "id": "healthy_d3", "label": "Track 1 — day 3 result", "default": "No significant barrier change" },
    { "type": "text", "id": "healthy_d14", "label": "Track 1 — day 14 result", "default": "Significant barrier impairment" },
    { "type": "text", "id": "aud_damaged", "label": "Track 2 title", "default": "Already irritated skin" },
    { "type": "text", "id": "damaged_d3", "label": "Track 2 — day 3 result", "default": "Significant barrier impairment" },
    { "type": "textarea", "id": "source", "label": "Source line", "default": "Sources: Ramsing & Agner, Contact Dermatitis, 1996 — short- and long-term experimental glove occlusion." }
  ],
  "presets": [{ "name": "DRYE NT — Barrier choice" }]
}
{% endschema %}
