{{ 'drye-nt-proof.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  DRYE NT — Proof
  Standalone, reusable proof/stat block (the 97% / 86% + "Verified survey"
  content lifted out of Pro reviews so it can be placed anywhere as its own
  section). Stats are blocks (add/remove/reorder in the editor); the survey
  footer is optional.
{%- endcomment -%}

{%- assign stats = section.blocks | where: 'type', 'stat' -%}

<section
  class="drye-nt drye-proof{% if section.settings.top_border %} has-border{% endif %}"
  id="drye-nt-proof-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-drye-section
  data-section-name="nt_proof"
>
  <div class="drye-proof__wrap">
    {%- if section.settings.eyebrow != blank -%}
      <span class="drye-proof__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="drye-proof__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if stats.size > 0 -%}
      <div class="drye-proof__stats" style="grid-template-columns: repeat({{ stats.size }}, 1fr)">
        {%- for block in stats -%}
          <div class="drye-proof__stat" {{ block.shopify_attributes }}>
            <div class="drye-proof__num">{{ block.settings.num }}</div>
            <p class="drye-proof__desc">{{ block.settings.desc }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.foot_title != blank or section.settings.foot_note != blank -%}
      <div class="drye-proof__foot">
        {%- if section.settings.foot_title != blank -%}
          <div class="drye-proof__foot-title">{{ section.settings.foot_title }}</div>
        {%- endif -%}
        {%- if section.settings.foot_note != blank -%}
          <p class="drye-proof__foot-note">{{ section.settings.foot_note }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "DRYE NT — Proof",
  "tag": "section",
  "class": "shopify-section-drye-nt-proof",
  "settings": [
    { "type": "checkbox", "id": "top_border", "label": "Top divider line", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "header", "content": "Survey footer (optional)" },
    { "type": "text", "id": "foot_title", "label": "Footer title", "default": "Verified survey of 500+ glove wearers" },
    { "type": "textarea", "id": "foot_note", "label": "Footer note", "default": "Post-purchase feedback from verified DRYE customers. Results vary by glove type, heat, and shift length." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "num", "label": "Number", "default": "97%" },
        { "type": "textarea", "id": "desc", "label": "Description", "default": "reported dry hands after 3+ hours on the job" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "DRYE NT — Proof",
      "blocks": [
        { "type": "stat", "settings": { "num": "97%", "desc": "reported dry hands after 3+ hours on the job" } },
        { "type": "stat", "settings": { "num": "86%", "desc": "noticed significant skin difference after only two weeks" } }
      ]
    }
  ]
}
{% endschema %}
