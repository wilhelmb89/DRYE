{{ 'drye-b2b-lp-base.css' | asset_url | stylesheet_tag }}

{{ 'drye-hockey-shared.css' | asset_url | stylesheet_tag }}
{{ 'drye-hockey-lp.js' | asset_url | script_tag }}
{{ 'drye-hockey-mechanism.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The glove turns to outline so the parent can see the state their kid's hand is
  in. Needs three transparent PNGs, all uploaded to Files:
    hand    — a white hand, sliding in from the left
    glove   — the glove outline
    mask    — a solid silhouette of the glove, used as a CSS mask so the haloes
              and droplets stay inside the glove shape

  Copy note: "occlusion" only appears here, after the reader has recognised the
  problem — never in the hero or a headline.
{%- endcomment -%}

{%- liquid
  assign ss = section.settings
  assign mask = ss.glove_mask | image_url: width: 1200
-%}

<section class="dryeNEW-section drye-hockey-mech dryeNEW-reveal" id="{{ ss.anchor_id | default: 'mechanism' }}" data-drye-section="hockey-mech">
  <div class="dryeNEW-container">
    <div class="drye-hockey-mech__grid">
      <div class="drye-hockey-mech__stagewrap">
        <div class="drye-hockey-mech__stage">
          {%- if ss.hand != blank -%}
            <div class="drye-hockey-mech__handbox">
              {{ ss.hand | image_url: width: 1200 | image_tag: class: 'drye-hockey-mech__hand', loading: 'lazy', alt: ss.hand_alt }}
            </div>
          {%- endif -%}

          {%- if mask -%}
            <div class="drye-hockey-mech__fill" aria-hidden="true" style="-webkit-mask-image:url({{ mask }});mask-image:url({{ mask }});-webkit-mask-size:contain;mask-size:contain;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:center;mask-position:center">
              <span class="drye-hockey-mech__halo">
                <span class="drye-hockey-mech__halo--1" style="background:radial-gradient(ellipse 46% 34% at 48% 52%, rgba(95,207,193,0.95) 0%, rgba(95,207,193,0.35) 45%, rgba(95,207,193,0) 72%)"></span>
                <span class="drye-hockey-mech__halo--2" style="background:radial-gradient(ellipse 40% 29% at 48% 52%, rgba(240,180,41,0.95) 0%, rgba(240,180,41,0.34) 48%, rgba(240,180,41,0) 74%)"></span>
                <span class="drye-hockey-mech__halo--3" style="background:radial-gradient(ellipse 31% 22% at 48% 52%, rgba(214,66,42,1) 0%, rgba(214,66,42,0.42) 50%, rgba(214,66,42,0) 76%)"></span>
              </span>
              <span class="drye-hockey-mech__fx">
{{ '' }}            <span class="drye-hockey-mech__drip" style="left:33%;top:60%;width:8px;height:10.4px;animation-delay:0s"></span>
            <span class="drye-hockey-mech__drip" style="left:41%;top:64%;width:6px;height:7.8px;animation-delay:0.6s"></span>
            <span class="drye-hockey-mech__drip" style="left:48%;top:61%;width:9px;height:11.7px;animation-delay:1.2s"></span>
            <span class="drye-hockey-mech__drip" style="left:56%;top:65%;width:7px;height:9.1px;animation-delay:0.4s"></span>
            <span class="drye-hockey-mech__drip" style="left:63%;top:62%;width:6px;height:7.8px;animation-delay:1.6s"></span>
            <span class="drye-hockey-mech__drip" style="left:69%;top:66%;width:8px;height:10.4px;animation-delay:1s"></span>
              </span>
            </div>
          {%- endif -%}

          {%- if ss.hand != blank -%}
            {{ ss.hand | image_url: width: 1200 | image_tag: class: 'drye-hockey-mech__inhand', loading: 'lazy', alt: '', aria-hidden: 'true' }}
          {%- endif -%}

          {%- if mask -%}
            <span class="drye-hockey-mech__edge" aria-hidden="true" style="-webkit-mask-image:url({{ mask }}),url({{ mask }});mask-image:url({{ mask }}),url({{ mask }});-webkit-mask-size:contain,97% 97%;mask-size:contain,97% 97%;-webkit-mask-position:center,center;mask-position:center,center;-webkit-mask-repeat:no-repeat,no-repeat;mask-repeat:no-repeat,no-repeat;-webkit-mask-composite:xor;mask-composite:exclude"></span>
          {%- endif -%}

          {%- if ss.glove != blank -%}
            {{ ss.glove | image_url: width: 1200 | image_tag: class: 'drye-hockey-mech__glove', loading: 'lazy', alt: ss.glove_alt }}
          {%- endif -%}

          <div class="drye-hockey-mech__legend" aria-hidden="true">
            <span><i style="background:#D6422A"></i>{{ ss.legend_1 | escape }}</span>
            <span><i style="background:#2CA6E0"></i>{{ ss.legend_2 | escape }}</span>
            <span><i style="background:#9DBF25"></i>{{ ss.legend_3 | escape }}</span>
          </div>

          {%- if ss.callout != blank -%}
            <div class="drye-hockey-mech__callout" aria-hidden="true">
              <span>{{ ss.callout | escape }}</span>
              <svg viewBox="0 0 160 100" width="118" height="74" fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M154 4 C142 26, 110 52, 66 70 C48 78, 30 86, 15 90"/>
                <path d="M34 93 L14 90 L28 76"/>
              </svg>
            </div>
          {%- endif -%}

          <div class="drye-hockey-mech__clock" data-drye-clock data-drye-clock-minutes="{{ ss.period_minutes }}" data-drye-clock-periods="{{ ss.period_count }}" aria-hidden="true">
            <span class="drye-hockey-mech__time" data-drye-clock-time>0:00</span>
            <span class="drye-hockey-mech__meter"><i data-drye-clock-meter></i></span>
            <span class="drye-hockey-mech__period" data-drye-clock-period>{{ ss.period_word | escape }} 1 {{ ss.period_of | escape }} {{ ss.period_count }}</span>
          </div>
        </div>
      </div>

      <div class="drye-hockey-mech__copy">
        {%- if ss.eyebrow != blank -%}
          <span class="dryeNEW-micro drye-hockey-mech__eyebrow">{{ ss.eyebrow | escape }}</span>
        {%- endif -%}

        {%- for block in section.blocks -%}
          <details class="drye-hockey-mech__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="drye-hockey-mech__summary">
              {%- if block.settings.is_result -%}
                <span class="drye-hockey-mech__eq" aria-hidden="true">=</span>
              {%- endif -%}
              <span class="drye-hockey-mech__term">{{ block.settings.term }}</span>
              <span class="drye-hockey-mech__plus" aria-hidden="true">+</span>
            </summary>
            {%- if block.settings.lead != blank -%}
              <p class="dryeNEW-body drye-hockey-mech__lead">{{ block.settings.lead }}</p>
            {%- endif -%}
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "drye-Hockey Mech",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "mechanism" },
    { "type": "header", "content": "Artwork (transparent PNG)" },
    { "type": "image_picker", "id": "hand", "label": "Hand (white, facing right)" },
    { "type": "text", "id": "hand_alt", "label": "Hand alt", "default": "A bare hand sliding into the glove" },
    { "type": "image_picker", "id": "glove", "label": "Glove outline" },
    { "type": "text", "id": "glove_alt", "label": "Glove alt", "default": "Outline of a hockey glove" },
    { "type": "image_picker", "id": "glove_mask", "label": "Glove fill mask (solid silhouette)" },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "callout", "label": "Glove callout", "default": "Hockey glove" },
    { "type": "text", "id": "legend_1", "label": "Legend 1 (red)", "default": "Heat" },
    { "type": "text", "id": "legend_2", "label": "Legend 2 (blue)", "default": "Trapped sweat" },
    { "type": "text", "id": "legend_3", "label": "Legend 3 (green)", "default": "Bacteria" },
    { "type": "header", "content": "Period clock" },
    { "type": "range", "id": "period_minutes", "label": "Minutes per period", "min": 5, "max": 30, "step": 1, "unit": "min", "default": 20 },
    { "type": "range", "id": "period_count", "label": "Periods", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "text", "id": "period_word", "label": "Word for period", "default": "Period" },
    { "type": "text", "id": "period_of", "label": "Word for \"of\"", "default": "of" },
    { "type": "header", "content": "Right column" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What occlusion is" }
  ],
  "blocks": [
    {
      "type": "term",
      "name": "Term",
      "settings": [
        { "type": "text", "id": "term", "label": "Term" },
        { "type": "richtext", "id": "lead", "label": "Explanation" },
        { "type": "checkbox", "id": "is_result", "label": "This is the result (shows =)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "drye-Hockey Mech",
      "blocks": [
        { "type": "term", "settings": { "term": "Heat", "lead": "<p>Sealed. Nothing carries it away.</p>" } },
        { "type": "term", "settings": { "term": "Trapped sweat", "lead": "<p>Inside a sealed glove the space around the hand is saturated within the warm-up.</p>" } },
        { "type": "term", "settings": { "term": "Bacteria", "lead": "<p>Warm and wet is the condition they do well in.</p>" } },
        { "type": "term", "settings": { "term": "Skin degradation", "lead": "<p>Overhydrated. Soft, then raw.</p>", "is_result": true } }
      ]
    }
  ]
}
{% endschema %}
