{{ 'drye-b2b-lp-base.css' | asset_url | stylesheet_tag }}

{{ 'drye-hockey-shared.css' | asset_url | stylesheet_tag }}
{{ 'drye-hockey-lp.js' | asset_url | script_tag }}
{{ 'drye-hockey-how-it-works.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ss = section.settings
-%}

<section class="dryeNEW-section drye-hockey-hiw dryeNEW-reveal" data-x="" id="{{ ss.anchor_id | default: 'how-it-works' }}" data-drye-section="hockey-hiw">
  <div class="dryeNEW-container">
    <div class="drye-hockey-hiw__head">
      {%- if ss.eyebrow != blank -%}
        <span class="dryeNEW-micro drye-hockey-hiw__eyebrow">{{ ss.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if ss.patent != blank -%}
        <span class="dryeNEW-micro drye-hockey-hiw__patent">{{ ss.patent | escape }}</span>
      {%- endif -%}
    </div>

    <h2 class="dryeNEW-h2 drye-hockey-hiw__title">{{ ss.heading }}</h2>

    <div class="drye-hockey-hiw__grid">
      {%- for block in section.blocks -%}
        <div class="drye-hockey-hiw__card drye-hockey-hiw__step--{{ forloop.index }} dryeNEW-reveal dryeNEW-rd{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="drye-hockey-hiw__card-head">
            <span class="drye-hockey-hiw__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="drye-hockey-hiw__step">{{ block.settings.step }}</span>
          </div>

          <span class="drye-hockey-hiw__meter" aria-hidden="true"><i></i></span>

          <div class="drye-hockey-hiw__figure" aria-hidden="true">
            {%- case block.settings.figure -%}
              {%- when 'beads' -%}
                <svg viewBox="0 0 300 178" fill="none" role="img" aria-label="Knitted structure with sweat beading on the inner layer" preserveAspectRatio="none">
                  <rect x="0" y="26" width="300" height="18" fill="#CFE9E5"></rect>
                  <rect x="0" y="138" width="300" height="18" fill="#E3E9EE"></rect>
                  <path class="drye-hockey-hiw__knit" d="M 54,136 L 54,100 C 54,66 112,66 112,100 L 112,136 M 102,136 L 102,100 C 102,66 160,66 160,100 L 160,136 M 150,136 L 150,100 C 150,66 208,66 208,100 L 208,136 M 198,136 L 198,100 C 198,66 256,66 256,100 L 256,136" stroke="#16263A" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path class="drye-hockey-hiw__knit" d="M 54,128 L 54,92 C 54,58 112,58 112,92 L 112,128 M 102,128 L 102,92 C 102,58 160,58 160,92 L 160,128 M 150,128 L 150,92 C 150,58 208,58 208,92 L 208,128 M 198,128 L 198,92 C 198,58 256,58 256,92 L 256,128" stroke="#0D9488" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span class="drye-hockey-hiw__drop drye-hockey-hiw__drop--1" style="bottom:20%;width:9px;height:11px"></span>

              {%- when 'routing' -%}
                <span class="drye-hockey-hiw__band drye-hockey-hiw__band--outer"></span>
                <span class="drye-hockey-hiw__band drye-hockey-hiw__band--inner"></span>
                <span class="drye-hockey-hiw__wet drye-hockey-hiw__wet--2" style="bottom:15%"></span>
                <span class="drye-hockey-hiw__drop drye-hockey-hiw__drop--2" style="width:10px;height:13px"></span>
                <span class="drye-hockey-hiw__pool"></span>

              {%- when 'stored' -%}
                <span class="drye-hockey-hiw__band drye-hockey-hiw__band--outer"></span>
                <span class="drye-hockey-hiw__band drye-hockey-hiw__band--inner"></span>
                <span class="drye-hockey-hiw__wet drye-hockey-hiw__wet--3" style="bottom:15%"></span>
                <span class="drye-hockey-hiw__fill"></span>
                <span class="drye-hockey-hiw__dash"></span>
                <span class="drye-hockey-hiw__mat drye-hockey-hiw__mat--outer">{{ section.settings.mat_outer | escape }}</span>
                <span class="drye-hockey-hiw__mat drye-hockey-hiw__mat--inner">{{ section.settings.mat_inner | escape }}</span>
                <span class="drye-hockey-hiw__mat drye-hockey-hiw__mat--clear">{{ section.settings.mat_clear | escape }}</span>
            {%- endcase -%}
          </div>

          {%- if block.settings.note != blank -%}
            <p class="drye-hockey-hiw__note">{{ block.settings.note | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "drye-Hockey Steps",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "how-it-works" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Asymmetric layering" },
    { "type": "text", "id": "patent", "label": "Right-hand micro", "default": "Patent pending · SE 2615359-3" },
    { "type": "html", "id": "heading", "label": "Headline", "default": "How it works" },
    { "type": "header", "content": "Figure labels (used by figure 03)" },
    { "type": "text", "id": "mat_outer", "label": "Outer layer", "default": "Outer lyocell" },
    { "type": "text", "id": "mat_inner", "label": "Inner layer", "default": "Inner \u00b7 polypropylene" },
    { "type": "text", "id": "mat_clear", "label": "Inner-layer state", "default": "Stays clear" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "step", "label": "Step headline" },
        { "type": "select", "id": "figure", "label": "Animated figure", "options": [ { "value": "beads", "label": "01 \u2014 sweat beads on the inner layer" }, { "value": "routing", "label": "02 \u2014 sweat routes up and out" }, { "value": "stored", "label": "03 \u2014 outer layer stores it" } ], "default": "beads" },
        { "type": "text", "id": "note", "label": "Under-figure micro" }
      ]
    }
  ],
  "presets": [
    {
      "name": "drye-Hockey Steps",
      "blocks": [
        { "type": "step", "settings": { "step": "5\u201310 min after glove use", "figure": "beads", "note": "Inner \u00B7 polypropylene" } },
        { "type": "step", "settings": { "step": "Material starts routing", "figure": "routing", "note": "Inner \u00B7 polypropylene" } },
        { "type": "step", "settings": { "step": "Material starts storing sweat into small pockets", "figure": "stored", "note": "Outer \u00B7 lyocell" } }
      ]
    }
  ]
}
{% endschema %}
