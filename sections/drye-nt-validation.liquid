{{ 'drye-nt-base.css' | asset_url | stylesheet_tag }}
{{ 'drye-nt-validation.css' | asset_url | stylesheet_tag }}

<section
  class="drye-nt validation"
  id="drye-nt-validation-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-drye-section
  data-section-name="nt_validation"
>
  <div class="dryeNEW-container">
    {%- if section.settings.eyebrow != blank -%}<span class="micro">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank or section.settings.heading_em != blank -%}
      <h2>{{ section.settings.heading }}{%- if section.settings.heading_em != blank -%}<br><em>{{ section.settings.heading_em }}</em>{%- endif -%}</h2>
    {%- endif -%}
    {%- if section.settings.lead != blank -%}<p class="lead">{{ section.settings.lead }}</p>{%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="institutions">
        {%- for block in section.blocks -%}
          {%- if block.type == 'institution' -%}
            <div class="institution" {{ block.shopify_attributes }}>
              <div class="inst-mark"><span>{{ block.settings.initial }}</span></div>
              <div><div class="inst-name">{{ block.settings.name }}</div><div class="inst-role">{{ block.settings.role }}</div></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign logo_blocks = section.blocks | where: 'type', 'logo' -%}
    {%- if logo_blocks.size > 0 -%}
      {%- if section.settings.logos_label != blank -%}<span class="validation-logos-label">{{ section.settings.logos_label }}</span>{%- endif -%}
      <div class="validation-logos-viewport">
        <div class="validation-logos">
          {%- for block in logo_blocks -%}
            <div class="validation-logo{% if block.settings.large %} validation-logo--lg{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}{{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name | escape }}{%- endif -%}
            </div>
          {%- endfor -%}
          <div class="validation-logos-dup" aria-hidden="true">
            {%- for block in logo_blocks -%}
              <div class="validation-logo{% if block.settings.large %} validation-logo--lg{% endif %}">
                {%- if block.settings.logo != blank -%}{{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "DRYE NT — External validation",
  "tag": "section",
  "class": "shopify-section-drye-nt-validation",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "External validation" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Independently tested." },
    { "type": "text", "id": "heading_em", "label": "Heading (italic line)", "default": "Not self-reported." },
    { "type": "textarea", "id": "lead", "label": "Lead paragraph", "default": "Seven years of R&D across three independent research institutions. The claims on this page are not based on the manufacturer's internal testing." },
    { "type": "text", "id": "logos_label", "label": "Logos label", "default": "In collaboration with" }
  ],
  "blocks": [
    {
      "type": "institution",
      "name": "Institution",
      "settings": [
        { "type": "text", "id": "initial", "label": "Initial letter", "default": "R" },
        { "type": "text", "id": "name", "label": "Name", "default": "Institution name" },
        { "type": "text", "id": "role", "label": "Role", "default": "Role description" }
      ]
    },
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo (white/transparent PNG)" },
        { "type": "text", "id": "name", "label": "Name (alt text)" },
        { "type": "checkbox", "id": "large", "label": "Larger size", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "DRYE NT — External validation",
      "blocks": [
        { "type": "institution", "settings": { "initial": "R", "name": "RISE Research Institutes of Sweden", "role": "Independent materials & textile validation" } },
        { "type": "institution", "settings": { "initial": "U", "name": "Uppsala University", "role": "Clinical conditions & dermatological impact" } },
        { "type": "institution", "settings": { "initial": "S", "name": "Swedish School of Textiles", "role": "Textile engineering & structural analysis" } },
        { "type": "logo", "settings": { "name": "Almi" } },
        { "type": "logo", "settings": { "name": "Borås INK" } },
        { "type": "logo", "settings": { "name": "Skånes universitetssjukhus", "large": true } },
        { "type": "logo", "settings": { "name": "Wargön Innovation" } },
        { "type": "logo", "settings": { "name": "Södertälje Science Park" } },
        { "type": "logo", "settings": { "name": "The Swedish School of Textiles", "large": true } },
        { "type": "logo", "settings": { "name": "Uminova Innovation" } },
        { "type": "logo", "settings": { "name": "Vinnova" } },
        { "type": "logo", "settings": { "name": "Uppsala Innovation Centre", "large": true } },
        { "type": "logo", "settings": { "name": "Uppsala Universitet", "large": true } }
      ]
    }
  ]
}
{% endschema %}
