{{ 'drye-nt-base.css' | asset_url | stylesheet_tag }}
{{ 'drye-liner-more-reviews.css' | asset_url | stylesheet_tag }}

<section
  class="dryeNEW-section drye-liner-more-reviews"
  id="liner-more-reviews"
  data-section-id="{{ section.id }}"
  data-drye-section
  data-section-name="more_reviews"
>
  <div class="dryeNEW-container">
    <div class="drye-liner-more-reviews__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="dryeNEW-micro drye-liner-more-reviews__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="dryeNEW-h2 drye-liner-more-reviews__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="drye-liner-more-reviews__rating">
        <span class="drye-liner-more-reviews__rating-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9734;</span>
        <span class="drye-liner-more-reviews__rating-score">{{ section.settings.score }}</span>
        <span class="drye-liner-more-reviews__rating-source">{{ section.settings.score_source }}</span>
      </div>
    </div>
  </div>

  <div class="drye-liner-more-reviews__wrap">
    <div class="drye-liner-more-reviews__track">
      {%- for block in section.blocks -%}
        <div class="drye-liner-more-reviews__card" {{ block.shopify_attributes }}>
          <div class="drye-liner-more-reviews__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="drye-liner-more-reviews__quote">{{ block.settings.quote }}</p>
          <div class="drye-liner-more-reviews__meta"><span class="drye-liner-more-reviews__verified" aria-hidden="true">&#10003;</span><span>{{ block.settings.author }}</span></div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="dryeNEW-container">
    <div class="drye-liner-more-reviews__dots">
      {%- for block in section.blocks -%}
        <div class="drye-liner-more-reviews__dot{% if forloop.first %} is-active{% endif %}"></div>
      {%- endfor -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="drye-liner-more-reviews__cta">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "DRYE — More reviews",
  "tag": "section",
  "class": "shopify-section-drye-liner-more-reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "More feedback" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From real customers." },
    { "type": "text", "id": "score", "label": "Score", "default": "4.4" },
    { "type": "text", "id": "score_source", "label": "Score source", "default": "10 reviews via Trustpilot" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "See all reviews on Trustpilot" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Author" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "DRYE — More reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "I have eczema and these liners have been the best things I bought for my hands. I wear latex gloves all day for work — every hour I'd change gloves and liners, and even with sweat on the DRYE, my hands stayed dry.", "author": "PN · US" } },
        { "type": "review", "settings": { "quote": "My son's hands were bright pink and raw from wearing work gloves. Within a few days of wearing the liners, his hands were drastically improved — within two weeks, completely healed.", "author": "Debby Fields · US" } },
        { "type": "review", "settings": { "quote": "Excellent fit, quick delivery, and they do as the site describes. They keep the sweat and extra heat off my palms — one of my triggers. If you've tried everything else, give these a try.", "author": "Jon · GB" } },
        { "type": "review", "settings": { "quote": "I've worn them under vinyl gloves, hockey gloves, and a wrist support — they alleviate irritation and itching from sweat really well. One developed a small hole, but customer service replaced it immediately. That alone earns 5 stars.", "author": "Alric · CA" } },
        { "type": "review", "settings": { "quote": "Coming up on a year with these liners — still comfortable, keep my hands dry, and no signs of wear. They do what they're supposed to.", "author": "Athena · SE" } }
      ]
    }
  ]
}
{% endschema %}
