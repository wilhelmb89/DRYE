{{ 'drye-hockey-objections.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Objection handling, ordered by how hard the belief is held (research: Hockey
  research, Oct 2026):

    1 Grip          — the deal-breaker for any player who cares about puck feel
    2 Not cotton    — "an extra layer just soaks through" is the top competing belief
    3 Adherence     — a child refusing to wear it is the critical adoption risk
    4 Timeline      — how fast anything changes
    5 Already drying— glove dryers and sprays are believed to already solve this
    6 Fit           — child-sized hands
    7 Durability    — one season
    8 Price         — last, after the value is established

  Every card carries proof in a customer's own words; a card without proof is a
  claim, not an answer. Never pair a claim with a quote that undercuts it — Eric's
  "six ice times a week" belongs under price (he re-ordered), not durability (she
  wore the pair out).
{%- endcomment -%}

<section class="dryeNEW-section drye-hockey-obj" id="{{ section.settings.anchor_id | default: 'objections' }}" data-drye-section="hockey-objections">
  {%- if section.settings.background != blank -%}
    <div class="drye-hockey-obj__bg" aria-hidden="true">
      {{ section.settings.background | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', alt: '' }}
      <span class="drye-hockey-obj__scrim drye-hockey-obj__scrim--ink"></span>
      <span class="drye-hockey-obj__scrim drye-hockey-obj__scrim--top"></span>
      <span class="drye-hockey-obj__scrim drye-hockey-obj__scrim--side"></span>
    </div>
  {%- endif -%}

  <div class="dryeNEW-container drye-hockey-obj__head">
    <h2 class="dryeNEW-h2 drye-hockey-obj__title">{{ section.settings.heading }}</h2>
  </div>

  <div class="dryeNEW-rail drye-hockey-obj__rail" data-drye-rail>
    <div class="dryeNEW-rail__track" data-drye-rail-track>
      {%- for block in section.blocks -%}
        <article class="drye-hockey-obj__card" {{ block.shopify_attributes }}>
          {%- if block.settings.profile != blank -%}
            <span class="dryeNEW-micro drye-hockey-obj__prof">{{ block.settings.profile | escape }}</span>
          {%- endif -%}
          <h3 class="dryeNEW-h3 drye-hockey-obj__q">{{ block.settings.question }}</h3>
          {%- if block.settings.answer != blank -%}
            <div class="dryeNEW-body--sm drye-hockey-obj__a">{{ block.settings.answer }}</div>
          {%- endif -%}
          {%- if block.settings.proof != blank -%}
            <p class="dryeNEW-body--sm drye-hockey-obj__proof">{{ block.settings.proof }}</p>
          {%- endif -%}
          {%- if block.settings.who != blank -%}
            <p class="dryeNEW-body--caption drye-hockey-obj__who">{{ block.settings.who | escape }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    <button type="button" class="dryeNEW-nav dryeNEW-nav--prev" data-drye-rail-prev aria-label="Previous questions">&larr;</button>
    <button type="button" class="dryeNEW-nav dryeNEW-nav--next" data-drye-rail-next aria-label="Next questions">&rarr;</button>
  </div>

  <div class="dryeNEW-container">{% render 'drye-hockey-swipe-hint' %}</div>
</section>

{% schema %}
{
  "name": "drye-Hockey Objections",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "objections" },
    { "type": "html", "id": "heading", "label": "Headline", "default": "What you'd ask another parent." },
    { "type": "image_picker", "id": "background", "label": "Background photo (optional)" }
  ],
  "blocks": [
    {
      "type": "objection",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "profile", "label": "Eyebrow" },
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" },
        { "type": "textarea", "id": "proof", "label": "Proof quote (verbatim)" },
        { "type": "text", "id": "who", "label": "Attribution" }
      ]
    }
  ],
  "presets": [
    {
      "name": "drye-Hockey Objections",
      "blocks": [
        { "type": "objection", "settings": { "profile": "Grip", "question": "Will it affect their play?", "answer": "<p>Sized to sit tight at 0.4 mm. A loose liner is what slides inside a glove.</p>", "proof": "“She appreciates that they fit tight on her hands and don’t introduce a ‘slip’ when she plays, which was a problem with cotton based gloves.”", "who": "Eric Dyke · hockey parent" } },
        { "type": "objection", "settings": { "profile": "Not cotton", "question": "Isn’t an extra layer just more to soak through?", "answer": "<p>Cotton absorbs, then holds the wet against the skin. DRYE routes it to the outer face instead — nothing saturates against the hand.</p>", "proof": "“Which was a problem with cotton based gloves.”", "who": "Eric Dyke · hockey parent" } },
        { "type": "objection", "settings": { "profile": "Adherence", "question": "Will he actually wear it?", "answer": "<p>It is 0.4 mm and black. Nothing shows outside the glove.</p>", "proof": "“I did one practice without them. I won’t want to do that again.”", "who": "Linnéa Pettersson Dove · Frölunda HC · SDHL champion 2025" } },
        { "type": "objection", "settings": { "profile": "Timeline", "question": "How fast does anything change?", "answer": "<p>Most of the messages we get arrive in the first month.</p>", "proof": "“He’s worn yours 3 ice times, his hands completely cleared up. No cream or prescription has helped.”", "who": "Adam Todd · hockey parent" } },
        { "type": "objection", "settings": { "profile": "Already drying", "question": "I already dry and spray his gloves.", "answer": "<p>A dryer works on the glove between skates. Neither one does anything for the hand during the hour it is sealed in there.</p>", "proof": "“It absolutely does not keep them fresh. It just dries them.”", "who": "Hockey parent, on glove dryers" } },
        { "type": "objection", "settings": { "profile": "Fit", "question": "Does it fit a child’s hand?", "answer": "<p>Measure the palm before ordering. Sizes run from a 10-year-old’s hand upward, and we have made a size that was not in the range.</p>", "proof": "“Size 7 was still a little too big for him.” 6.5 was made for him.", "who": "Siobhan Brown · hockey parent" } },
        { "type": "objection", "settings": { "profile": "Durability", "question": "Will it last a season?", "answer": "<p>Machine washable, goes in with the jerseys. Two pairs and there is always a dry one in the bag.</p>", "proof": "“Yes, the gloves have been holding up well.” — a year after the first pair.", "who": "Siobhan Brown · hockey parent" } },
        { "type": "objection", "settings": { "profile": "Price", "question": "Why does it cost more than cotton liners?", "answer": "<p>One pair covers a season of regular use. At 90 skates that is 43¢ a skate — and thirty days, full refund, if it does nothing.</p>", "proof": "“She destroyed the first pair, hence the order.” — six ice times a week.", "who": "Eric Dyke · hockey parent" } }
      ]
    }
  ]
}
{% endschema %}
