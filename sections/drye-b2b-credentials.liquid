{{ 'drye-b2b-credentials.css' | asset_url | stylesheet_tag }}

<section class="drye-b2b sec" id="{{ section.settings.anchor_id | default: 'credentials' }}">
  {%- if section.settings.eyebrow != blank -%}
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}

  <div class="cred-grid">
    {%- for block in section.blocks -%}
      <div class="cred" {{ block.shopify_attributes }}>
        <span class="cred__ico">{% render 'drye-b2b-icon', icon: block.settings.icon %}</span>
        <p class="cred__title">{{ block.settings.title }}</p>
        {%- if block.settings.sub != blank -%}<p class="cred__sub">{{ block.settings.sub | escape }}</p>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "drye-B2B Creds",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "credentials" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trust & credentials" },
    { "type": "html", "id": "heading", "label": "Headline" }
  ],
  "blocks": [
    { "type": "credential", "name": "Credential", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "pin",
        "options": [
          { "value": "pin", "label": "Location" }, { "value": "flask", "label": "Flask" },
          { "value": "award", "label": "Award" }, { "value": "layers", "label": "Layers" },
          { "value": "drop", "label": "Droplet" }, { "value": "doc", "label": "Document" }
        ] },
      { "type": "html", "id": "title", "label": "Title" },
      { "type": "text", "id": "sub", "label": "Sub" }
    ]}
  ],
  "presets": [{ "name": "drye-B2B Creds" }]
}
{% endschema %}
