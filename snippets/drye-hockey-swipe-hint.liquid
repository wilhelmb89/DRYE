{%- comment -%}
  Mobile-only swipe cue. Markup and animation live in the global base
  (.swipe-hint, @keyframes swipe-travel) — this snippet only places it.
  Usage: {% render 'drye-hockey-swipe-hint' %}
{%- endcomment -%}
<div class="swipe-hint" aria-hidden="true">
  <span class="swipe-hint__label">{{ label | default: 'Swipe' }}</span>
  <span class="swipe-hint__track"><span class="swipe-hint__dot"></span></span>
</div>
