{%- comment -%}
  Hairline icon set, 1.4px stroke, inherits currentColor (navy on this page). Usage:
    {% render 'drye-b2b-icon', icon: 'glove' %}
  Ships with a 22px intrinsic size so an unstyled use cannot blow up to fill its
  container. Any section that wants a different size overrides it in CSS.
{%- endcomment -%}
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {%- case icon -%}
    {%- when 'box' -%}<path d="M3 8l9-5 9 5-9 5-9-5z"></path><path d="M3 8v8l9 5 9-5V8"></path><path d="M12 13v8"></path>
    {%- when 'tube' -%}<path d="M9 3h6v3H9z"></path><path d="M8 6h8v13a2 2 0 01-2 2h-4a2 2 0 01-2-2z"></path><path d="M10 12h4"></path>
    {%- when 'calendar' -%}<rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path><path d="M9 15h6"></path>
    {%- when 'pause' -%}<circle cx="12" cy="12" r="9"></circle><path d="M10 9v6M14 9v6"></path>
    {%- when 'knit' -%}<circle cx="12" cy="12" r="9"></circle><path d="M12 3v18M3 12h18"></path><path d="M6 6l12 12M18 6L6 18"></path>
    {%- when 'drop' -%}<path d="M12 3s6 6 6 11a6 6 0 01-12 0c0-5 6-11 6-11z"></path>
