{% comment %}
  ============================================================================
  DRYE Cart Drawer — handoff snippet
  Render once in theme.liquid (end of <body>): {% render 'drye-cart-drawer' %}
  The drawer is populated from the live Shopify cart via cart.js — this
  Liquid pass only renders the FIRST-PAINT state (no flash before JS boots).
  drye-cart-drawer.js re-renders it on every add/change/remove.

  ARCHITECTURE NOTE — read before wiring:
  The prototype's "pack tiers" (1–6 pairs, tiered % off) are a single
  product's line items grouped together, one line item PER PAIR so each
  pair can carry its own size (Shopify's cart can't split one line's
  quantity across variants). Pack quantity = sum of those lines' quantities.
  Pricing (the tier discount, and the flat-rate "out of stock size" rate)
  is intentionally NOT computed client-side here — it must come from your
  real quantity-break discount setup (Shopify Function / native volume
  pricing / discount app), same as the PDP buy-zone patch. This snippet and
  its JS only DISPLAY whatever cart.js returns (cart.items, cart.total_price,
  cart.original_total_price, cart.cart_level_discount_applications). Wire
  drye_pairs_product below to your liner product/handle.
  ============================================================================
{% endcomment %}

{% assign drye_pairs_product = section.settings.pairs_product_handle | default: 'drye-moisture-routing-glove-liners' %}
{% assign drye_product = all_products[drye_pairs_product] %}

{% comment %} Expose variant-id lookup by size label, for the JS size-stepper to swap variants via /cart/change.js + /cart/add.js. Adjust the option index (option1/2/3) to match where "Size" sits in your product's options. {% endcomment %}
<script type="application/json" id="drye-size-variants">
  {
    {% for variant in drye_product.variants %}
      "{{ variant.option1 | escape }}": {{ variant.id }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  }
</script>

<div class="drye-cart-overlay" data-drye-cart-overlay></div>

<aside class="drye-cart-drawer" role="dialog" aria-modal="true" aria-label="Your cart" data-drye-cart-drawer>

  <div class="drye-cart-head">
    <div class="drye-cart-head__title-wrap">
      <span class="drye-cart-head__title">Your cart</span>
      <span class="drye-cart-head__count" data-drye-cart-count>{{ cart.item_count }} items</span>
    </div>
    <div class="drye-cart-head__actions">
      <div class="drye-cart-currency">{{ cart.currency.iso_code }}</div>
      <button type="button" class="drye-cart-close" data-drye-cart-close aria-label="Close cart">✕</button>
    </div>
  </div>

  <div class="drye-cart-region">
    <span class="drye-cart-region__flag">🌍</span>
    <span>Prices shown in {{ cart.currency.iso_code }}</span>
  </div>

  <div class="drye-cart-ship">
    <div class="drye-cart-ship__msg" data-drye-cart-ship-msg>
      {% comment %} JS overwrites this on every cart update against your real free-shipping threshold {% endcomment %}
    </div>
    <div class="drye-cart-ship__track">
      <div class="drye-cart-ship__fill" data-drye-cart-ship-fill style="width: 0%;"></div>
    </div>
  </div>

  <div class="drye-cart-body" data-drye-cart-body>
    {% comment %} Server-rendered first paint; JS replaces this innerHTML after fetch('/cart.js') resolves. See drye-cart-drawer.js renderCart(). {% endcomment %}
    {% if cart.item_count > 0 %}
      <div class="drye-cart-pack">
        <div class="drye-cart-pack__title">{{ cart.item_count }} {% if cart.item_count == 1 %}Pair{% else %}Pairs{% endif %}</div>
        <div class="drye-cart-pack__price">{{ cart.total_price | money }}</div>
      </div>
    {% else %}
      <div class="drye-cart-empty">
        <div class="drye-cart-empty__icon">🛒</div>
        <div class="drye-cart-empty__title">Your cart is empty</div>
        <div class="drye-cart-empty__sub">Add a pair to continue.</div>
        <a href="{{ drye_product.url | default: '/collections/all' }}" class="drye-cart-empty__cta">Shop now</a>
      </div>
    {% endif %}
  </div>

  <div class="drye-cart-upsell" data-drye-cart-upsell hidden>
    <div class="drye-cart-upsell__title">Add more pairs</div>
    <div class="drye-cart-upsell__sub">Keep extra dry liners ready for rotation, backup, or your team.</div>
    <div class="drye-cart-upsell__cards">
      <div class="drye-cart-upsell__card">
        <div class="drye-cart-upsell__name">4 pairs · Extra rotation</div>
        <div class="drye-cart-upsell__price" data-drye-upsell-price="4"></div>
        <button type="button" class="drye-cart-upsell__btn" data-drye-cart-set-pairs="4">Upgrade to 4 pairs</button>
      </div>
      <div class="drye-cart-upsell__card drye-cart-upsell__card--best">
        <div class="drye-cart-upsell__badge">Best team value</div>
        <div class="drye-cart-upsell__name">6 pairs · Team rotation</div>
        <div class="drye-cart-upsell__price" data-drye-upsell-price="6"></div>
        <button type="button" class="drye-cart-upsell__btn drye-cart-upsell__btn--solid" data-drye-cart-set-pairs="6">Upgrade to 6 pairs</button>
      </div>
    </div>
  </div>

  <div class="drye-cart-summary">
    <div class="drye-cart-summary__row">
      <span class="drye-cart-summary__label">Subtotal</span>
      <span class="drye-cart-summary__value" data-drye-cart-subtotal>{{ cart.original_total_price | money }}</span>
    </div>
    <div class="drye-cart-summary__row" data-drye-cart-discount-row hidden>
      <span class="drye-cart-summary__label">Pack discount</span>
      <span class="drye-cart-summary__value drye-cart-summary__value--discount" data-drye-cart-discount>−{{ cart.total_discount | money }}</span>
    </div>
    <div class="drye-cart-summary__total">
      <span class="drye-cart-summary__total-label">Total</span>
      <span class="drye-cart-summary__total-value" data-drye-cart-total>{{ cart.total_price | money }}</span>
    </div>
    <a href="{{ routes.cart_url }}" class="drye-cart-checkout">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2l7 3v6c0 4.5-3 8.2-7 9-4-.8-7-4.5-7-9V5l7-3z" stroke="white" stroke-width="1.5" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Secure checkout →
    </a>
    <button type="button" class="drye-cart-continue" data-drye-cart-close>Continue shopping</button>
  </div>
</aside>

<button type="button" class="drye-cart-open-btn" data-drye-cart-open style="top: 20px; left: 20px;" hidden>Open cart</button>
