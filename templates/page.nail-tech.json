    "drye_section_06_faq_h937Hc": {
      "type": "drye-section-06-faq",
      "blocks": {
        "faq_item_3kyJxA": {
          "type": "faq_item",
          "settings": {
            "question": "What if I have long or sharp nails?",
            "answer": "Long, sharp nails can wear through the fingertip fabric over time. If that happens, DRYE can still function as a moisture-routing layer under your nitrile glove, but the nail tip itself will not be covered by the textile.\n\nSome users choose to trim a small opening at the fingertip as a workaround. It is not the cleanest look, and it does not protect the nail area, but the liner can still work for the rest of the hand."
          }
        },
        "faq_item_P8tAUf": {
          "type": "faq_item",
          "settings": {
            "question": "Does it work under nitrile gloves specifically?",
            "answer": "Yes. DRYE is made to be worn under nitrile gloves. It is 0.4 mm thin, so it fits under standard gloves without changing your outer glove."
          }
        },
        "faq_item_JpnHYA": {
          "type": "faq_item",
          "settings": {
            "question": "What if it doesn't work for me?",
            "answer": "You have 30 days to try it. If it doesn’t improve your shift, you get a refund."
          }
        },
        "faq_item_zB3hk8": {
          "type": "faq_item",
          "settings": {
            "question": "Can I wash it? How?",
            "answer": "Yes. Machine wash cold or warm. No fabric softener. Air dry flat. Wash after each shift."
          }
        },
        "faq_item_aWcXAV": {
          "type": "faq_item",
          "settings": {
            "question": "How long does it last? ",
            "answer": "With regular use and washing, most users should expect 6–12 months. The function is built into the textile structure, not a coating that washes out."
          }
        },
        "faq_item_P863DU": {
          "type": "faq_item",
          "settings": {
            "question": "Who it’s not for ",
            "answer": "DRYE works best when gloves stay on for longer periods. If you remove gloves every few minutes, the liner may not have enough time to help. Non-sterile use only."
          }
        }
      },
