    "nt_mechanism": {
      "type": "drye-liner-mechanism",
      "settings": {
        "section_id": "liner-mechanism",
        "heading": "Every other liner saturates. DRYE",
        "heading_emphasis": "routes.",
        "vs_label": "Cotton · DRYE",
        "cotton_name": "Cotton",
        "cotton_steps": "Sweat enters the fabric and stays\nAt saturation, moisture sits on skin\nSame wet glove on shift 1 as shift 8",
        "drye_name": "DRYE Liner",
        "drye_steps": "Skin side repels — sweat cannot sit there\nOuter side pulls moisture toward it\nContinuous transport, no saturation point"
      }
    },
    "nt_reviews": {
      "type": "drye-liner-more-reviews",
      "blocks": {
        "v1": {
          "type": "review",
          "settings": {
            "quote": "I have eczema and these liners have been the best things I bought for my hands. I wear latex gloves all day for work — every hour I’d change gloves and liners, and even with sweat on the DRYE, my hands stayed dry.",
            "author": "PN · US"
          }
        },
        "v2": {
          "type": "review",
          "settings": {
            "quote": "My son’s hands were bright pink and raw from wearing work gloves. Within a few days of wearing the liners, his hands were drastically improved — within two weeks, completely healed.",
            "author": "Debby Fields · US"
          }
        },
        "v3": {
          "type": "review",
          "settings": {
            "quote": "Excellent fit, quick delivery, and they do as the site describes. They keep the sweat and extra heat off my palms — one of my triggers. If you’ve tried everything else, give these a try.",
            "author": "Jon · GB"
          }
        },
        "v4": {
          "type": "review",
          "settings": {
            "quote": "I’ve worn them under vinyl gloves, hockey gloves, and a wrist support — they alleviate irritation and itching from sweat really well. One developed a small hole, but customer service replaced it immediately. That alone earns 5 stars.",
            "author": "Alric · CA"
          }
        },
        "v5": {
          "type": "review",
          "settings": {
            "quote": "Coming up on a year with these liners — still comfortable, keep my hands dry, and no signs of wear. They do what they’re supposed to.",
            "author": "Athena · SE"
          }
        }
      },
      "block_order": [
        "v1",
        "v2",
        "v3",
        "v4",
        "v5"
      ],
      "settings": {
        "eyebrow": "More feedback",
        "heading": "From real customers.",
        "score": "4.4",
        "score_source": "10 reviews via Trustpilot",
        "cta_label": "See all reviews on Trustpilot",
        "cta_url": "https://se.trustpilot.com/review/hudsverige.se"
      }
    },
