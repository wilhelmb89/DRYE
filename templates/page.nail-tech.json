      "settings": {
        "chapter": "04",
        "heading": "Why trapped moisture ruins your skin and nails over time.",
        "aud_1": "Healthy skin",
        "aud_2": "Already irritated skin",
        "sum_1": "Holds, then gives way",
        "sum_2": "Gone by day 3",
        "call_1": "No change at day 3 — impairment by day 14",
        "call_2": "Significant barrier impairment — day 3",
        "row_1_label": "No significant barrier change",
        "row_1_sub": "Healthy skin · day 3",
        "row_2_label": "Significant barrier impairment",
        "row_2_sub": "Healthy skin · day 14",
        "row_3_label": "Significant barrier impairment",
        "row_3_sub": "Already irritated skin · day 3",
        "risk_label": "Maceration risk rises",
        "day_1": "Day 1",
        "day_2": "Day 3",
        "day_3": "Day 7",
        "day_4": "Day 14",
        "source": "Source: Ramsing & Agner, Contact Dermatitis 1996 — occlusive glove use, 6 h/day; and Tiedemann et al., Contact Dermatitis 2016 — occlusion on experimentally irritated skin."
      }
    },
