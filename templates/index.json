    "drye_nt_real_reviews_P837F8": {
      "type": "drye-nt-real-reviews",
      "blocks": {
        "review_FRiKVM": {
          "type": "review",
          "settings": {
            "initials": "PN",
            "avatar_color": "#bfe9dd",
            "name": "PN",
            "meta": "US · 2 reviews",
            "title": "Great liners that work!",
            "quote": "I have eczema and these liners have been the best things I bought for my hands. I have to wear latex gloves all day for work. I'd wear the DRYE liners then the latex gloves on top. Every hour, I would change my gloves (and liners) and notice the sweat on my DRYE — but my hands remain dried. When my skin is dried and cracked, I would wear just the DRYE at home and my hands feel better. Thank you so much for making these! I have seven pairs to rotate. Have been wearing them for a few months now. Machine wash every other day (laid to dry under sunlight in between washes). Still great condition.",
            "date": "Jun 15, 2025"
          }
        },
        "review_hbfheJ": {
          "type": "review",
          "settings": {
            "initials": "DF",
            "avatar_color": "#f7d2a8",
            "name": "Debby Fields",
            "meta": "US · 3 reviews",
            "title": "Incredible difference! Worth every penny!",
            "quote": "My son's hands were bright pink and raw with all of the skin peeling off from wearing work gloves. I researched the best solutions and DRYE liners were considered the best. Within a few days of wearing the liners, his hands were drastically improved. Within two weeks, they are completely healed and back to normal. I cannot believe the difference! I also bought a rack to dry the gloves and have now purchased multiple pairs to allow for more washing and rotation to prevent reoccurrence, but these liners made a tremendous difference! Additionally, I was unsure of the best size and customer service was prompt and amazingly helpful. I highly recommend! Worth every penny!",
            "date": "Aug 17, 2025"
          }
        },
        "review_rzX6ja": {
          "type": "review",
          "settings": {
            "initials": "JO",
            "avatar_color": "#f6c7dc",
            "name": "Jon",
            "meta": "GB · 1 review",
            "title": "Gloves have performed really very well so far",
            "quote": "Gloves have performed very well so far, excellent fit, quick delivery and they do as the site describes. They keep the sweat and some extra heat from my palms which are one of my triggers. I'd recommend if like me you've tried everything and it doesn't work — give these a try.",
            "date": "May 1, 2025"
          }
        },
