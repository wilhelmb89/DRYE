          "settings": {
            "shipping_html": "<style>\n  .policy-table-scroll {\n    width: 100%;\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n    margin-top: 16px;\n  }\n\n  .policy-table-scroll .delivery-table {\n    min-width: 640px;\n  }\n\n  .policy-scroll-hint {\n    display: none;\n    font-size: 12px;\n    color: #6f7d8f;\n    margin-top: 8px;\n  }\n\n  .policy-details {\n    margin-top: 40px;\n    border-top: 1px solid #dfe4ea;\n    padding-top: 24px;\n  }\n\n  .policy-details summary {\n    cursor: pointer;\n    font-weight: 600;\n    font-size: 15px;\n    list-style: none;\n  }\n\n  .policy-details summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .policy-details summary::after {\n    content: \" +\";\n    color: #6f7d8f;\n  }\n\n  .policy-details[open] summary::after {\n    content: \" –\";\n  }\n\n  .policy-details .policy-section {\n    margin-top: 32px;\n  }\n\n  @media screen and (max-width: 749px) {\n    .policy-table-scroll .delivery-table {\n      min-width: 680px;\n    }\n\n    .policy-scroll-hint {\n      display: block;\n    }\n\n    .delivery-table th,\n    .delivery-table td {\n      vertical-align: top;\n    }\n  }\n</style>\n\n<div class=\"policy-section\" id=\"what-to-expect\">\n  <span class=\"ps-label\">Overview</span>\n  <h2 class=\"ps-h\">Shipping</h2>\n\n  <div class=\"ps-body\">\n    <p>\n      We ship worldwide from Stockholm. Orders dispatch within\n      <strong>12–24 hours</strong> Monday to Friday, excluding Swedish public\n      holidays. Weekend and holiday orders ship the next business day.\n    </p>\n\n    <p>\n      You pick the speed at checkout. Everything else follows from that choice.\n    </p>\n  </div>\n\n  <div class=\"policy-stat-row\" style=\"margin-top:24px;\">\n    <div class=\"policy-stat\">\n      <div class=\"policy-stat-num\">12–24<em>h</em>\n</div>\n      <div class=\"policy-stat-lbl\">Dispatch time, Mon–Fri</div>\n    </div>\n\n    <div class=\"policy-stat\">\n      <div class=\"policy-stat-num\">3</div>\n      <div class=\"policy-stat-lbl\">Shipping options</div>\n    </div>\n\n    <div class=\"policy-stat\">\n      <div class=\"policy-stat-num\">SE</div>\n      <div class=\"policy-stat-lbl\">Made and shipped in Sweden</div>\n    </div>\n  </div>\n</div>\n\n<div class=\"policy-section\" id=\"options\">\n  <span class=\"ps-label\">Choose</span>\n  <h2 class=\"ps-h\">Your options</h2>\n\n  <div class=\"ps-body\">\n    <p>\n      Same terms wherever you live — United States, Canada, Europe, United\n      Kingdom, Norway, Australia, New Zealand.\n    </p>\n  </div>\n\n  <div class=\"policy-table-scroll\">\n    <table class=\"delivery-table\">\n      <thead>\n        <tr>\n          <th>You choose</th>\n          <th>Duty &amp; tax</th>\n          <th>Delivery</th>\n          <th>Tracking</th>\n        </tr>\n      </thead>\n\n      <tbody>\n        <tr>\n          <td><strong>Economy</strong></td>\n          <td><strong>Included</strong></td>\n          <td>10–20 days</td>\n          <td>No</td>\n        </tr>\n\n        <tr>\n          <td><strong>Economy Tracked</strong></td>\n          <td><strong>Included</strong></td>\n          <td>10–20 days</td>\n          <td>Yes</td>\n        </tr>\n\n        <tr>\n          <td><strong>UPS Express</strong></td>\n          <td>Billed by UPS on delivery</td>\n          <td>2–3 days<br>Europe next day</td>\n          <td>Yes</td>\n        </tr>\n\n        <tr>\n          <td>\n<strong>3 pairs or more</strong><br>any shipping option</td>\n          <td><strong>Included. Nothing at the door.</strong></td>\n          <td>2–3 days<br>Europe next day</td>\n          <td>Yes</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n\n  <p class=\"policy-scroll-hint\">Scroll sideways to see all columns.</p>\n\n  <div class=\"callout\">\n    <p>\n      <strong>Order three pairs and we cover everything</strong> — express\n      shipping, duty, tax, customs handling. No second invoice, wherever you\n      live.\n    </p>\n  </div>\n</div>\n\n<div class=\"policy-section\" id=\"ups-express\">\n  <span class=\"ps-label\">If you pick express</span>\n  <h2 class=\"ps-h\">What UPS bills you on 1–2 pairs</h2>\n\n  <div class=\"ps-body\">\n    <p>\n      UPS Express on one or two pairs ships under DAP terms. UPS clears the\n      parcel and invoices you directly on delivery. Two lines:\n    </p>\n  </div>\n\n  <ul class=\"policy-list\">\n    <li>\n      <strong>A customs entry fee</strong> — around USD 17 to the United States.\n      UPS sets it.\n    </li>\n    <li>\n      <strong>Import duty and local tax</strong> — roughly 15% of order value to\n      the United States. Canada is 0% duty under CETA, plus 5–15% provincial tax\n      depending on where you live.\n    </li>\n  </ul>\n\n  <div class=\"callout\">\n    <p>\n      We never see those charges and cannot waive them. If you would rather not\n      deal with them, pick Economy or order three pairs.\n    </p>\n  </div>\n</div>\n\n<div class=\"policy-section\" id=\"economy\">\n  <span class=\"ps-label\">If you pick economy</span>\n  <h2 class=\"ps-h\">Why it takes 10–20 days</h2>\n\n  <div class=\"ps-body\">\n    <p>\n      New US customs rules mean every parcel now clears individually, including\n      letter mail. That clearance is where the time goes. It is not warehouse\n      time — your order left Stockholm within 24 hours.\n    </p>\n  </div>\n\n  <div class=\"callout callout-warn\">\n    <p>\n      <strong>Economy is untracked.</strong> There is no tracking number, and if\n      the parcel goes missing we cannot trace it. That is the trade you are\n      making for the lower price. Economy Tracked costs slightly more and\n      removes it.\n    </p>\n  </div>\n</div>\n\n<div class=\"policy-section\" id=\"delivery-issues\">\n  <span class=\"ps-label\">Problems</span>\n  <h2 class=\"ps-h\">If something goes wrong</h2>\n\n  <div class=\"ps-body\">\n    <p>\n      Damaged or incomplete on arrival? Email\n      <a href=\"mailto:info@drye.se\">info@drye.se</a> within\n      <strong>7 days of delivery</strong>.\n    </p>\n\n    <p>\n      We cannot control carrier delays from weather, customs, or strikes. We\n      will still help you sort it out.\n    </p>\n\n    <p>\n      Returns within 30 days. No forms. No restocking fee. No questions.\n    </p>\n\n    <p>\n      Questions? <a href=\"mailto:info@drye.se\">info@drye.se</a> — we answer\n      within 24 hours.\n    </p>\n  </div>\n</div>\n\n<details class=\"policy-details\" id=\"full-terms\">\n  <summary>Full customs terms, country by country</summary>\n\n  <div class=\"policy-section\">\n    <span class=\"ps-label\">Definitions</span>\n    <h2 class=\"ps-h\">Import terms</h2>\n\n    <div class=\"policy-table-scroll\">\n      <table class=\"delivery-table\">\n        <thead>\n          <tr>\n            <th>Label</th>\n            <th>Meaning</th>\n          </tr>\n        </thead>\n\n        <tbody>\n          <tr>\n            <td><strong>Included / DDP</strong></td>\n            <td>DRYE pays the listed import charges before dispatch.</td>\n          </tr>\n\n          <tr>\n            <td><strong>Not included / DAP</strong></td>\n            <td>The recipient pays applicable import charges on delivery.</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"callout\">\n      <p>\n        Economy and Economy Tracked ship DDP on every order. UPS Express ships\n        DAP on 1–2 pairs and DDP on 3 pairs or more.\n      </p>\n    </div>\n  </div>\n\n  <div class=\"policy-section\">\n    <span class=\"ps-label\">Origin</span>\n    <h2 class=\"ps-h\">Country of origin</h2>\n\n    <div class=\"ps-body\">\n      <p>\n        DRYE liners are manufactured in Sweden. Origin is declared as EU on all\n        commercial invoices.\n      </p>\n\n      <p>\n        <strong>Canada:</strong> EU-origin goods qualify for 0% customs duty\n        under CETA. Provincial import tax and carrier handling fees still apply.\n      </p>\n\n      <p>\n        <strong>United States:</strong> EU-origin goods fall under the EU–US\n        trade agreement ceiling. Rates are set by US Customs and Border\n        Protection and may change.\n      </p>\n    </div>\n  </div>\n\n  <div class=\"policy-section\">\n    <span class=\"ps-label\">Canada</span>\n    <h2 class=\"ps-h\">Provincial import tax</h2>\n\n    <div class=\"ps-body\">\n      <p>\n        Applies to DAP shipments only. Orders of three pairs or more ship DDP\n        with tax included.\n      </p>\n    </div>\n\n    <div class=\"policy-table-scroll\">\n      <table class=\"delivery-table\">\n        <thead>\n          <tr>\n            <th>Province or territory</th>\n            <th>Typical tax rate</th>\n          </tr>\n        </thead>\n\n        <tbody>\n          <tr>\n<td>AB, NT, NU, YT</td>\n<td>5%</td>\n</tr>\n          <tr>\n<td>SK</td>\n<td>11%</td>\n</tr>\n          <tr>\n<td>BC, MB</td>\n<td>12%</td>\n</tr>\n          <tr>\n<td>ON</td>\n<td>13%</td>\n</tr>\n          <tr>\n<td>NS</td>\n<td>14%</td>\n</tr>\n          <tr>\n<td>QC</td>\n<td>14.975%</td>\n</tr>\n          <tr>\n<td>NB, NL, PE</td>\n<td>15%</td>\n</tr>\n        </tbody>\n      </table>\n    </div>\n\n    <p class=\"policy-scroll-hint\">Scroll sideways to see all columns.</p>\n\n    <div class=\"callout\">\n      <p>\n        UPS Express DAP shipments to Canada also carry a UPS entry fee.\n      </p>\n    </div>\n  </div>\n\n  <div class=\"policy-section\">\n    <span class=\"ps-label\">Rest of world</span>\n    <h2 class=\"ps-h\">UK, Norway, Australia, New Zealand</h2>\n\n    <div class=\"ps-body\">\n      <p>\n        On UPS Express DAP shipments of 1–2 pairs, local VAT or GST, duty, and\n        UPS entry fees may apply on delivery. Economy shipments and orders of\n        three pairs or more ship DDP with these charges included.\n      </p>\n\n      <p>\n        Orders within the EU carry no customs charges. VAT is included in the\n        price shown.\n      </p>\n    </div>\n\n    <div class=\"callout callout-warn\">\n      <p>\n        Customs authorities and carriers make the final assessment. Rates and\n        carrier fees may change without notice.\n      </p>\n    </div>\n  </div>\n\n  <div class=\"policy-section\">\n    <span class=\"ps-label\">Carriers</span>\n    <h2 class=\"ps-h\">Who carries what</h2>\n\n    <ul class=\"policy-list\">\n      <li>\n<strong>Economy</strong> — PostNord Untracked Letter</li>\n      <li>\n<strong>Economy Tracked</strong> — PostNord Tracked Letterbox</li>\n      <li>\n<strong>UPS Express</strong> — UPS Express Saver</li>\n    </ul>\n  </div>\n\n  <p class=\"policy-updated\">Last updated: August 7, 2026.</p>\n</details>",
            "returns_html": "<div class=\"policy-section\" id=\"guarantee\">\n  <span class=\"ps-label\">Our commitment</span>\n  <h2 class=\"ps-h\">30-day money-back guarantee</h2>\n  <div class=\"ps-body\">\n    <p>If it doesn't work for you, return within 30 days. Contact us and we'll handle the rest.</p>\n  </div>\n  <div class=\"policy-stat-row\" style=\"margin-top:24px;\">\n    <div class=\"policy-stat\">\n      <div class=\"policy-stat-num\">30<em>d</em>\n</div>\n      <div class=\"policy-stat-lbl\">Return window from delivery</div>\n    </div>\n    <div class=\"policy-stat\">\n      <div class=\"policy-stat-num\">5–10<em>d</em>\n</div>\n      <div class=\"policy-stat-lbl\">Refund processing after approval</div>\n    </div>\n    <div class=\"policy-stat\">\n      <div class=\"policy-stat-num\">0</div>\n      <div class=\"policy-stat-lbl\">Forms to fill. One email to start.</div>\n    </div>\n  </div>\n</div>\n\n<div class=\"policy-section\" id=\"eligibility\">\n  <span class=\"ps-label\">Requirements</span>\n  <h2 class=\"ps-h\">Eligibility</h2>\n  <div class=\"ps-body\">\n    <p>To qualify for a return:</p>\n  </div>\n  <ul class=\"policy-list\">\n    <li>Product must be in original condition — undamaged</li>\n    <li>Return must be requested within 30 days of receiving your order</li>\n    <li>Light use is accepted — we understand the need to try them in real conditions</li>\n  </ul>\n</div>\n\n<div class=\"policy-section\" id=\"how-to-return\">\n  <span class=\"ps-label\">Process</span>\n  <h2 class=\"ps-h\">How to start a return</h2>\n  <div class=\"step-list\">\n    <div class=\"step\">\n      <div class=\"step-num\">01</div>\n      <div class=\"step-body\">\n        <div class=\"step-title\">Email <a href=\"mailto:info@drye.se\" style=\"color:var(--emerald);text-decoration:none;\">info@drye.se</a>\n</div>\n        <div class=\"step-desc\">Include your order number and a short reason. Short and simple is fine.</div>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"step-num\">02</div>\n      <div class=\"step-body\">\n        <div class=\"step-title\">We send return instructions</div>\n        <div class=\"step-desc\">We confirm eligibility and provide return shipping details. You cover return shipping unless the product was damaged or incorrect.</div>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"step-num\">03</div>\n      <div class=\"step-body\">\n        <div class=\"step-title\">Refund issued within 5–10 business days</div>\n        <div class=\"step-desc\">Processed to your original payment method after approval. You'll receive a confirmation email.</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div class=\"policy-section\" id=\"refunds\">\n  <span class=\"ps-label\">Money back</span>\n  <h2 class=\"ps-h\">Refunds</h2>\n  <ul class=\"policy-list\">\n    <li>Refund to your original payment method</li>\n    <li>Processed within <strong>5–10 business days</strong> after approval</li>\n    <li>Confirmation email sent once issued</li>\n  </ul>\n</div>\n\n<div class=\"policy-section\" id=\"what-can-be-returned\">\n  <span class=\"ps-label\">Conditions</span>\n  <h2 class=\"ps-h\">What can be returned</h2>\n  <div class=\"ps-body\">\n    <p>You can return liners even if they've been lightly used. Excessive wear or damage may disqualify a full refund — assessed case by case.</p>\n  </div>\n  <div class=\"callout\">\n    <p>Questions? Email <a href=\"mailto:info@drye.se\">info@drye.se</a> — business hours 08:00–17:00 CET.</p>\n  </div>\n  <p class=\"policy-updated\">This policy applies to all purchases made directly from <a href=\"https://www.drye.se\">www.drye.se</a>.</p>\n</div>",
            "privacy_html": "<div class=\"policy-section\" id=\"privacy-intro\">\n  <span class=\"ps-label\">Overview</span>\n  <h2 class=\"ps-h\">Privacy policy</h2>\n  <div class=\"ps-body\">\n    <p>This policy explains how we collect, use, and protect your personal information. We follow GDPR and other applicable laws. This applies to all visitors and customers on drye.se.</p>\n    <p>DRYE AB, reg. no. 559313-1476, is responsible for your personal data. Questions? Email <a href=\"mailto:info@drye.se\">info@drye.se</a>.</p>\n  </div>\n</div>\n\n<div class=\"policy-section\" id=\"what-we-collect\">\n  <span class=\"ps-label\">Data collection</span>\n  <h2 class=\"ps-h\">What we collect and why</h2>\n  <div class=\"ps-body\">\n    <p>We only collect data necessary to provide our products and services.</p>\n  </div>\n  <ul class=\"policy-list\">\n    <li>Name, email, phone number</li>\n    <li>Delivery and billing address</li>\n    <li>Order and transaction details</li>\n    <li>Communication history with us</li>\n  </ul>\n  <div class=\"ps-body\" style=\"margin-top:20px;\">\n    <p>We use this to fulfill orders, provide customer support, handle returns, and improve site functionality. We only send marketing if you've opted in.</p>\n  </div>\n</div>\n\n<div class=\"policy-section\" id=\"your-rights\">\n  <span class=\"ps-label\">Your rights</span>\n  <h2 class=\"ps-h\">You control your data</h2>\n  <div class=\"ps-body\">\n    <p>At any time, you can:</p>\n  </div>\n  <ul class=\"policy-list\">\n    <li>Request a copy of your data</li>\n    <li>Ask us to correct or delete your data</li>\n    <li>Object to how we use your data</li>\n    <li>Withdraw consent at any time</li>\n  </ul>\n  <div class=\"callout\" style=\"margin-top:16px;\">\n    <p>Email <a href=\"mailto:info@drye.se\">info@drye.se</a> to exercise your rights.</p>\n  </div>\n</div>\n\n<div class=\"policy-section\" id=\"sms\">\n  <span class=\"ps-label\">SMS</span>\n  <h2 class=\"ps-h\">SMS communication</h2>\n  <div class=\"ps-body\">\n    <p>If you opt into SMS messages, we may send order updates, shipping notifications, abandoned cart reminders, and review requests. Standard message and data rates apply.</p>\n  </div>\n  <div class=\"callout\" style=\"border-left-color:#ef4444;background:#fcf7f7;\">\n    <p>Opt out anytime by replying <strong>STOP</strong> or emailing <a href=\"mailto:info@drye.se\">info@drye.se</a>.</p>\n  </div>\n</div>\n\n<div class=\"policy-section\" id=\"data-sharing\">\n  <span class=\"ps-label\">Third parties</span>\n  <h2 class=\"ps-h\">Sharing of data</h2>\n  <div class=\"ps-body\">\n    <p>We do not sell your data. We only share it with trusted third parties necessary for delivering our service — logistics, payment processing, and warehousing. These partners follow our instructions and cannot use your data for their own purposes.</p>\n  </div>\n  <div class=\"callout\">\n    <p>Questions? Email <a href=\"mailto:info@drye.se\">info@drye.se</a>.</p>\n  </div>\n</div>",
            "terms_html": "<div class=\"policy-section\" id=\"terms-intro\">\n  <span class=\"ps-label\">Overview</span>\n  <h2 class=\"ps-h\">Terms of use</h2>\n  <div class=\"ps-body\">\n    <p>By visiting and using drye.se, you agree to these terms. Please read carefully and contact us if you have questions.</p>\n  </div>\n</div>\n\n<div class=\"policy-section\" id=\"copyright\">\n  <span class=\"ps-label\">Intellectual property</span>\n  <h2 class=\"ps-h\">Copyright &amp; trademarks</h2>\n  <div class=\"ps-body\">\n    <p>All content on this website — including text, images, logos, and software — is protected by copyright and belongs to DRYE or our licensors. You may not copy, distribute, modify, or use any content without our written consent.</p>\n    <p>All trademarks, logos, and service marks displayed on this website are owned by DRYE or our licensors. You may not use any of these without our written permission.</p>\n  </div>\n</div>\n\n<div class=\"policy-section\" id=\"disclaimer\">\n  <span class=\"ps-label\">Liability</span>\n  <h2 class=\"ps-h\">Disclaimer</h2>\n  <div class=\"ps-body\">\n    <p>We aim to provide accurate and up-to-date information, but we cannot guarantee completeness or accuracy. We are not responsible for any errors or omissions.</p>\n    <p>This site may contain links to third-party websites. We are not responsible for the content or operation of these sites and do not control their ownership.</p>\n  </div>\n</div>\n\n<div class=\"policy-section\" id=\"user-responsibility\">\n  <span class=\"ps-label\">Your responsibility</span>\n  <h2 class=\"ps-h\">User responsibility</h2>\n  <div class=\"ps-body\">\n    <p>By using this website, you agree to comply with applicable laws and not use the site for illegal or unauthorized purposes. You are responsible for keeping your account and password secure and notifying us of any unauthorized activity.</p>\n  </div>\n</div>\n\n<div class=\"policy-section\" id=\"changes\">\n  <span class=\"ps-label\">Updates</span>\n  <h2 class=\"ps-h\">Changes to terms</h2>\n  <div class=\"ps-body\">\n    <p>We reserve the right to modify these terms at any time without notice. It is your responsibility to review the terms regularly for updates.</p>\n  </div>\n  <div class=\"callout\">\n    <p>Questions? Email <a href=\"mailto:info@drye.se\">info@drye.se</a>.</p>\n  </div>\n</div>"
          }
        }
      },
