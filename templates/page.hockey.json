    "objections": {
      "type": "drye-hockey-objections",
      "blocks": {
        "objection_1": {
          "type": "objection",
          "settings": {
            "profile": "Grip",
            "question": "Will it affect their play?",
            "proof": "“Cotton liners made my daughter’s hands slippery inside the glove and it affected her grip. DRYE fit tight and didn’t slip.”",
            "who": "Eric Dyke · hockey parent"
          }
        },
        "objection_2": {
          "type": "objection",
          "settings": {
            "profile": "Durability",
            "question": "Will the seams hold?",
            "proof": "“Six ice times a week.”",
            "who": "Eric Dyke · hockey parent"
          }
        },
        "objection_3": {
          "type": "objection",
          "settings": {
            "profile": "Timeline",
            "question": "How fast does anything change?",
            "proof": "“No cream or prescription helped for years. His hands cleared after three ice times.”",
            "who": "Adam Todd · hockey parent"
          }
        },
        "objection_4": {
          "type": "objection",
          "settings": {
            "profile": "Fit",
            "question": "Does it fit a child’s hand?",
            "proof": "“Ten years old, travel team, severe eczema. His hands healed completely.”",
            "who": "Allison M. Goldberg · hockey parent"
          }
        },
        "objection_5": {
          "type": "objection",
          "settings": {
