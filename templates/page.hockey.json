            "role": "Hockey player, Dallas"
          }
        },
        "voice_6": {
          "type": "voice",
          "settings": {
            "quote": "“My 11-year-old daughter plays hockey and has bad eczema from the gloves.”",
            "name": "Krista Seebaran",
            "role": "Hockey parent"
          }
        },
        "voice_7": {
          "type": "voice",
          "settings": {
            "quote": "“Eczema mostly on the hands from the hockey gloves. The glove liners we tried affected his shot.”",
            "name": "Iva Reid",
            "role": "Hockey parent"
