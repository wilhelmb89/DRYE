    "voices": {
      "type": "drye-hockey-peer-voices",
      "blocks": {
        "voice_1": {
          "type": "voice",
          "settings": {
            "quote": "“My son has been struggling with severe dry hands because of his hockey gloves for the past few years. No cream or prescription has helped.”",
            "name": "Adam Todd",
            "role": "Hockey parent"
          }
        },
        "voice_2": {
          "type": "voice",
          "settings": {
            "quote": "“He was embarrassed at school and had trouble playing comfortably.”",
            "name": "Allison M. Goldberg",
            "role": "Hockey parent"
          }
        },
        "voice_3": {
          "type": "voice",
          "settings": {
            "quote": "“My daughter has severe eczema on her hands and plays a lot of ice hockey. She needed some relief from her hockey gloves.”",
            "name": "Eric Dyke",
            "role": "Hockey parent"
          }
        },
        "voice_4": {
          "type": "voice",
          "settings": {
            "quote": "“He loves to play hockey and lacrosse but the gloves make his eczema worse.”",
            "name": "Siobhan Brown",
            "role": "Hockey parent"
          }
        },
        "voice_5": {
          "type": "voice",
          "settings": {
            "quote": "“My hands typically get an inflamed rash after wearing hockey gloves. The dermatologist called it contact dermatitis.”",
            "name": "Chris Pickett",
            "role": "Hockey player, Dallas"
          }
        },
        "voice_6": {
          "type": "voice",
          "settings": {
            "quote": "“My 11-year-old daughter plays hockey and has bad eczema from the gloves.”",
            "name": "Krista Seebaran",
            "role": "Hockey parent"
          }
        },
        "voice_7": {
          "type": "voice",
          "settings": {
            "quote": "“Eczema mostly on the hands from the hockey gloves. The glove liners we tried affected his shot.”",
            "name": "Iva Reid",
            "role": "Hockey parent"
          }
        }
      },
      "block_order": [
        "voice_1",
        "voice_2",
        "voice_3",
        "voice_4",
        "voice_5",
        "voice_6",
        "voice_7"
      ]
    },
